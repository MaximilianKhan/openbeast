import os, random, re, subprocess, sys
import vlib
LANG = '@LANG@'
D = '/tmp/eval_divmod'
EXT = {'python': 'py', 'go': 'go', 'c': 'c', 'cpp': 'cpp', 'rust': 'rs', 'zig': 'zig'}[LANG]
SRC = os.path.join(D, 'divmod.' + EXT)
if not os.path.lexists(SRC):
    print('missing ' + SRC); sys.exit(1)
RAW = vlib.read_source(SRC)
if RAW is None:
    print('divmod.%s must be a regular file (not a symlink) of at most 4 MB' % EXT); sys.exit(1)
src = RAW.decode('utf-8', 'replace')


def strip_c(s, keep_strings):
    # One pass over C-like source: drop // and /* */ comments; blank string,
    # char and (go) raw-string literals unless keep_strings.
    out, i, n = [], 0, len(s)
    while i < n:
        c = s[i]
        if s.startswith('//', i):
            j = s.find('\n', i); i = n if j < 0 else j
        elif s.startswith('/*', i):
            j = s.find('*/', i + 2); i = n if j < 0 else j + 2; out.append(' ')
        elif c in '"`' or (c == "'" and LANG != 'rust'):
            j = i + 1
            while j < n and s[j] != c:
                if s[j] == '\\' and c != '`':
                    j += 1
                elif s[j] == '\n' and c != '`':
                    break
                j += 1
            out.append(s[i:j + 1] if keep_strings else c + c); i = j + 1
        else:
            out.append(c); i += 1
    return ''.join(out)


if LANG == 'python':
    bad = vlib.lint_python(src, ban_modules=('gmpy2', 'decimal', 'fractions'))
    if bad:
        print('forbidden construct: ' + bad[0]); sys.exit(1)
else:
    code = strip_c(src, keep_strings=False)
    lits = strip_c(src, keep_strings=True)
    BAN = {
        'go': [(lits, r'"math/big"'), (lits, r'"C"'), (code, r'\bbig\s*\.')],
        'c': [(lits, r'#\s*include\s*[<"][^>"\n]*gmp'), (code, r'\bmpz_'), (code, r'\b_(?:BitInt|ExtInt)\b')],
        'cpp': [(lits, r'#\s*include\s*[<"][^>"\n]*(?:gmp|boost)'), (code, r'\bmpz_'),
                (code, r'\bcpp_int\b'), (code, r'\b_(?:BitInt|ExtInt)\b')],
        'rust': [(code, r'\bextern\s+crate\b'), (code, r'\bnum_bigint\b'), (code, r'#\s*!?\s*\[\s*link\b')],
        'zig': [(code, r'\.\s*big\b'), (code, r'@(?:field|cImport|cInclude|Int|Type)\b'),
                (code, r'\bmeta\s*\.\s*Int\b'), (lits, r'@import\s*\(\s*"(?!std")')],
    }[LANG]
    for text, pat in BAN:
        if re.search(pat, text):
            print('forbidden big-integer construct: /%s/' % pat); sys.exit(1)
    if LANG == 'zig':
        # native arbitrary-width integers (u65536) would replace the limb code
        for w in re.findall(r'\b[iu](\d+)\b', code):
            if int(w) > 128:
                print('forbidden integer width u%s (max 128)' % w); sys.exit(1)
BUILD = {
    'python': None,
    'go': ['go', 'build', '-o', 'divmod', 'divmod.go'],
    'c': ['gcc', '-O2', '-std=c11', '-Wall', '-Wextra', '-o', 'divmod', 'divmod.c'],
    'cpp': ['g++', '-O2', '-std=c++17', '-Wall', '-Wextra', '-o', 'divmod', 'divmod.cpp'],
    'rust': ['rustc', '-O', '-o', 'divmod', 'divmod.rs'],
    'zig': ['zig', 'build-exe', '-O', 'ReleaseFast', 'divmod.zig', '-femit-bin=divmod'],
}[LANG]
if BUILD:
    # Only the source, copied (never followed) into a private dir, compiled
    # under the solution's read-deny: the compiler runs with this script's
    # rights, and `#include "<repo>/evals/refs/..."` would hand it the reference.
    bdir, why = vlib.build_private({'divmod.' + EXT: RAW}, BUILD, lang=LANG, timeout=vlib.t(60),
                                   extra_env={'CGO_ENABLED': '0'})
    if why:
        print(why); sys.exit(1)
    if not vlib.is_native_executable(os.path.join(bdir, 'divmod')):
        print('build failed: no native executable'); sys.exit(1)
    RUN = [os.path.join(bdir, 'divmod')]
    # warm-up exec on an empty input: the first exec of a fresh binary on
    # macOS pays the Gatekeeper scan (3-11 s of WALL, not CPU), which must not
    # count against the timed run. It is judged: a solution that hangs on an
    # empty input fails HERE, inside the harness's 30 s validator budget
    # (build + 15 s), instead of being killed with the validator and rerun
    # as an infra timeout.
    w = vlib.run_solution(RUN, input='0\n', cpu_s=2, wall_s=15, cwd=D)
    if w.verdict in ('cpu', 'wall'):
        print('solution timed out on the empty warm-up input: ' + w.reason); sys.exit(1)
    if w.verdict != 'ok':
        print('solution rejected on the empty warm-up input: ' + w.reason); sys.exit(1)
else:
    RUN = vlib.python_cmd(SRC)

# ---- oracle: python bigints, Algorithm D trace window by window ----
BB = 1 << 32
MM = BB - 1


def val(a):
    x = 0
    for d in reversed(a):
        x = (x << 32) | d
    return x


def limbs(x):
    o = []
    while x:
        o.append(x & MM); x >>= 32
    return o or [0]


def oracle(u, v):
    U, V = val(u), val(v)
    Q, Rm = divmod(U, V)
    n = len(limbs(V))
    ulen = len(limbs(U)) if U else 0
    d3 = d6 = 0
    if n > 1 and ulen >= n:
        m = ulen - n
        s = 31 - (V.bit_length() - 1) % 32
        Vn, Un = V << s, U << s
        v1 = Vn >> (32 * (n - 1))
        v2 = (Vn >> (32 * (n - 2))) & MM
        R = Un >> (32 * (m + 1))
        for j in range(m, -1, -1):
            W = (R << 32) | ((Un >> (32 * j)) & MM)
            qh, rh = divmod(W >> (32 * (n - 1)), v1)
            u2 = (W >> (32 * (n - 2))) & MM
            while qh >= BB or qh * v2 > BB * rh + u2:
                qh -= 1; d3 += 1; rh += v1
                if rh >= BB:
                    break
            q = W // Vn
            d6 += qh != q
            R = W - q * Vn
    return '%s\n%s\n%d %d' % (' '.join(map(str, limbs(Q))), ' '.join(map(str, limbs(Rm))), d3, d6)


# ---- hidden tests: seeded generator + fixed q-hat overshoot / add-back vectors ----
AB = """3 3 7ffffffe 1fffffff 80000001/20000000 80000000 40000000
ffffffff 80000000 7ffffffe 3fffffff/3 fffffffd 7ffffffe
7ffffffe 7469d12e 7fffffff c0000000 ffffffff/40000000 20000000 40000000
2 20000000 c0000000 7ffffffe/7fffffff c0000000 7ffffffe
7fffffff 5db3b3a1 1 3fffffff 40000000/80000002 1fffffff 20000000
80000000 0 3fffffff 20000000/2 3fffffff 20000000
