7fffffff ffffffff 40000000 3 40000000 0 80000001 c0000000/80000001 40000000 1fffffff 80000001 c0000000"""
H = 1 << 31
PAL = [0, 1, 2, 3, MM, MM - 1, MM - 2, H, H - 1, H + 1, H - 2, H + 2, 0x40000000, 0x3fffffff,
       0xc0000000, 0x7ffffffe, 0x20000000, 0x1fffffff, 0x80000001]
rng = random.Random(0x163D1F)
cases = []


def add(u, v):
    cases.append((list(u), list(v)))


def rnd(k):
    return [rng.getrandbits(32) for _ in range(k)]


# edges
add([0], [1]); add([0], [0, 0, 5]); add([7], [7]); add([6], [7]); add([MM] * 6, [MM] * 3)
add([MM] * 5, [1]); add([5, 0, 0], [0, 1]); add([0, 0, 0, 1], [0, 1]); add([1, 2, 3], [4, 5, 6, 7])
add([0, 0, H], [0, H]); add([MM, MM, MM], [H]); add([3, H, H], [5, H]); add([MM, H, H], [MM, H])
add([0, 0, 0, H, 0, 0], [1, 0, H]); add([0, 0, H, 0x7fffffff], [1, 0, H]); add([0, 0, 0, H, 0], [1, 0, H])
add([3, 0, H, H], [1, 0, 0x20000000]); add([MM, MM, MM, MM], [MM, MM])
x = rnd(5); add(x + [0, 0], x + [0])
x = rnd(4); x[-1] |= H; add([0] * 3 + x, x)
x = rnd(3); x[-1] |= 1; add(limbs(val(x) * val(x) + val(x) - 1), x)
# add-back (D6) vectors, bare and with extra low limbs / high zero limbs
for ln in AB.strip().split('\n'):
    us, vs = ln.split('/')
    u = [int(t, 16) for t in us.split()]; v = [int(t, 16) for t in vs.split()]
    add(u, v)
    add(rnd(rng.randint(1, 4)) + u + [0] * rng.randint(0, 2), v + [0] * rng.randint(0, 1))
# q-hat overshoot: structured limbs (q-hat == b, D3 corrections, s == 0)
for _ in range(700):
    n = rng.randint(2, 6); m = rng.randint(0, 6)
    v = [rng.choice(PAL) if rng.random() < 0.85 else rng.getrandbits(32) for _ in range(n)]
    u = [rng.choice(PAL) if rng.random() < 0.85 else rng.getrandbits(32) for _ in range(m + n)]
    if not any(v):
        v[0] = 1
    if rng.random() < 0.3:
        u[-1] = v[-1]
    add(u, v)
# uniform random
for _ in range(1150):
    lv = rng.choice([1, 1, 2, 2, 3]) if rng.random() < 0.3 else rng.randint(1, 30)
    lu = rng.randint(1, 60)
    v = rnd(lv); u = rnd(lu)
    r = rng.random()
    if r < 0.25:
        v[-1] |= H
    elif r < 0.45:
        v[-1] >>= rng.randint(1, 31)
    if not any(v):
        v[0] = 1
    if rng.random() < 0.1:
        u += [0] * rng.randint(1, 3)
    if rng.random() < 0.1:
        v += [0] * rng.randint(1, 3)
    add(u, v)
# large
for lu, lv in ((2000, 1000), (1000, 999), (1500, 2), (600, 1200), (1600, 37), (900, 450)):
    u, v = rnd(lu), rnd(lv)
    v[-1] |= 1
    if lv == 450:
        v[-1] |= H
    add(u, v)

inp = [str(len(cases))]
for u, v in cases:
    inp.append('%d %d' % (len(u), len(v)))
    inp.append(' '.join(map(str, u)))
    inp.append(' '.join(map(str, v)))
inp = '\n'.join(inp) + '\n'
# references take 0.3-0.8 s of CPU (python ~2 s); budgets are at scale 1
r = vlib.run_solution(RUN, input=inp, cpu_s=6, wall_s=20, cwd=D)
if r.verdict in ('cpu', 'wall'):
    print('solution timed out: ' + r.reason); sys.exit(1)
if r.verdict != 'ok':
    print('solution rejected: ' + r.reason); sys.exit(1)
if r.returncode:
    print('solution exited %d' % r.returncode); sys.exit(1)
got = [ln.split() for ln in r.stdout.strip().split('\n')]
for i, (u, v) in enumerate(cases):
    want = [ln.split() for ln in oracle(u, v).split('\n')]
    if got[3 * i:3 * i + 3] != want:
        print('mismatch at case %d of %d' % (i, len(cases))); sys.exit(1)
if len(got) != 3 * len(cases):
    print('extra output lines'); sys.exit(1)
print('OK %d cases' % len(cases))
