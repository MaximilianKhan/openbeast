# openbeast-scope: mem-limit-pct=90 memlock=infinity host-class=rig min-mem-gib=118
#
# Project Maya serving the SAME weights as the llama.cpp big-mode profile
# serve-glm53-flash-abl-q2kxl-big.sh: huihui-ai's abliterated GLM-5.3-Flash
# UD-Q2_K_XL, pinned in scripts/weights.registry. Same weights is the point:
# scripts/engine-gate.sh then compares engines, not quants. Maya runs it
# through --gguf-dir ("other quants than these four are experimental: they
# run, but Maya is not measured with them", docs/SETUP.md at v1.1.65).
# Unverified on the rig: the runbook's Maya section says what to check.
#
# Parsed by scripts/engines/maya.sh (KEY=VALUE, never sourced). The scope
# line above is the same big-mode raise as the llama.cpp profile (90% on the
# rig only, memlock unlimited), read by start.sh through the adapter.
GGUF=Huihui-GLM-5.3-Flash-abliterated-UD-Q2_K_XL-00001-of-00004.gguf
SERVED_MODEL_NAME=glm-5.3-flash-abl-q2kxl
# Maya's GLM contexts are 8192, 32768, 65536 or 131072.
CONTEXT=131072
# Maya pins every free byte of RAM except this for its expert tier (its own
# default is 6). Inside a 90% scope next to the stack it must leave far more:
# at start ~113 GiB are free, the scope holds ~110 of them, and the stack plus
# Maya's own unpinned memory need ~7 inside it. 16 keeps the pin near 97 GiB.
RAM_HEADROOM_GB=16
VRAM_RESERVE_MIB=700
