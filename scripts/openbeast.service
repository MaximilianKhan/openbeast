# OpenBeast boot-start unit (user service).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   sed "s|@REPO@|$(pwd)|" scripts/openbeast.service > ~/.config/systemd/user/openbeast.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now openbeast
#   loginctl enable-linger $USER   # start at BOOT, not just at login
#
# Notes:
# - start.sh -d already runs the stack inside its own memory-capped
#   transient scope (openbeast-stack); this unit just triggers it at boot
#   and tears it down via stop.sh. RemainAfterExit tracks the pair.
# - Secrets stay in openbeast.conf (mode 600) — nothing passes through the
#   unit environment.

[Unit]
Description=OpenBeast local AI stack
# NOTE: docker.service here is aspirational only — a USER manager cannot
# order against SYSTEM units, so this line is ignored at boot. The real
# boot-race handling is start.sh's docker-info wait loop; don't "fix" a
# race by editing this ordering.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO@
# Quoted: a checkout path with a space must stay one argument — unquoted,
# systemd split it and refused the unit ("…/my is not executable"). The sed
# line above substitutes the path as-is, so a path containing % $ \ or "
# still needs those escaped by hand here (%% $$ \\ \").
ExecStart="@REPO@/start.sh" -d
ExecStop="@REPO@/stop.sh"
# start.sh -d owns the deadline: it waits OPENBEAST_LLAMA_LOAD_GRACE + 300 s
# for the stack (1200 s by default — a slow disk, or a failed load followed
# by a rollback load, can use all of it) and then exits non-zero itself. A
# unit timeout below that (this was 900) killed the launcher while the stack
# was still coming up: the unit went "failed", `systemctl --user stop
# openbeast` no longer ran ExecStop, and the next start said "already
# running". No fixed number here can track a raised load grace either.
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
