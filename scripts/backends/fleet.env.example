# OpenBeast — the Sparks a backup populates (docs/SPARK_BACKUP_RESTORE.md §3).
# Read by scripts/backends/spark-restore.sh. Parsed, never sourced.
#
# One line per node, in RANK ORDER, NODE_0 first (the head):
#   NODE_<i>=<tailnet-name> <head|worker> <fabric-ip>[,<second-rail-ip>]
# The tailnet name is the identity OpenBeast uses (spark-1, spark-2, ...);
# the factory hostname (spark-XXXX) is left as DGX OS set it. The first fabric
# address is the one the launchers use (SPARK_NODE_IP; NODE_0's is every
# node's SPARK_HEAD_IP). Each node's addresses must be the ones NVIDIA Sync (or
# your switch netplan) actually gives it: the restore writes spark.env, it does
# not address the ports.
FLEET_NAME=spark-hydra
FLEET_USER=max
NODE_0=spark-1 head 10.100.216.1,10.100.217.1
NODE_1=spark-2 worker 10.100.216.2,10.100.217.2
# A third and fourth Spark on a switch (one subnet every node is on), e.g.:
# NODE_2=spark-3 worker 10.100.216.3,10.100.217.3
# NODE_3=spark-4 worker 10.100.216.4,10.100.217.4

# The ssh key every node shares (NVIDIA Sync's cluster key, restored from the backup).
FLEET_SSH_KEY=id_ed25519_nvsync_cluster_assistant
# Units enabled (not started) per role.
FLEET_HEAD_UNITS="openbeast.service deepseek-v41-inference.service openbeast-logrotate.timer openbeast-watchdog.timer"
FLEET_WORKER_UNITS="opencode-model-link.service"
# Write the worker's opencode-model-link unit (127.0.0.1:8000 -> the head over the fabric).
FLEET_WORKER_MODEL_LINK=true
