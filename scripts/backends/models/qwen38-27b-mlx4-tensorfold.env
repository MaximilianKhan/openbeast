# Qwen3.8-27B MLX-4bit on TensorFold, both Sparks (TP 2). TensorFold runs this
# family on two ranks ONLY from MLX affine weights (NVFP4/EXL3 are one GPU —
# data/tensorfold.json). Migrated from the pre-profile spark.env defaults;
# REVISION pinned from https://huggingface.co/api/models/Vontra/Qwen3.8-27B-MLX-4bit
# on 2026-09-29. Fetch it first (model-fetch.sh): TensorFold cannot pin a
# revision on its own.
BACKEND=tensorfold
SOURCE=Vontra/Qwen3.8-27B-MLX-4bit
REVISION=70ae7fac63274ff2eac54152031433374cb80f2f
SERVED_MODEL_NAME=local-model
TENSOR_PARALLEL_SIZE=2
# Empty = the model's own window. Both ranks read the same profile.
MAX_MODEL_LEN=
# auto = one request at a time on CUDA; an integer enables shared rounds.
TENSORFOLD_PARALLEL=auto
