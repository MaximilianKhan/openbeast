# Stock NVIDIA Qwen3.8-27B NVFP4 on vLLM, both Sparks (TP 2) — the M1
# acceptance model (docs/DGX_SPARK_PLAN.md §11: censored, not benchmarked here).
# Migrated from the pre-profile spark.env defaults; REVISION pinned from
# https://huggingface.co/api/models/nvidia/Qwen3.8-27B-NVFP4 on 2026-09-29.
# model-inspect.sh @ that commit: 21.9 GB ModelOpt NVFP4+FP8, fits ONE Spark;
# TP 2 buys KV room and aggregate throughput.
BACKEND=vllm
SOURCE=nvidia/Qwen3.8-27B-NVFP4
REVISION=482ca0f3832238542f8f5295dde86b5f22711d80
SERVED_MODEL_NAME=qwen3.8-27b-nvfp4
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=262144
# VERIFY ON HARDWARE: playbook 0.8, Qwen3.6-27B TP2 recipe 0.5, vLLM blog 0.85.
GPU_MEMORY_UTILIZATION=0.80
MAX_NUM_SEQS=8
REASONING_PARSER=qwen3
# qwen3_xml and qwen3_coder are one parser class at the vendored vLLM commit
# (data/vllm.json); VERIFY ON HARDWARE with conformance.sh on the NGC image.
TOOL_CALL_PARSER=qwen3_xml
# SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}
EXTRA_ARGS=["--kv-cache-dtype","fp8","--enable-prefix-caching"]
