# OpenBeast model profile — everything the Spark launchers need to know about ONE model.
#
# Copy to scripts/backends/models/<name>.env (the file name is the profile
# name: letters, digits, . _ -), or let the inspector draft it:
#   scripts/backends/model-inspect.sh <owner/repo@<commit sha>> --write-profile <name>
# then resolve every "# VERIFY" and check it:
#   python3 scripts/backends/pylib/obprofile.py check <name>
#
# Used by:
#   scripts/backends/model-fetch.sh           --profile <name>   download + verify + lock
#   scripts/backends/vllm/spark-node.sh       --profile <name> --rank 0|1
#   scripts/backends/tensorfold/spark-node.sh --profile <name> --rank 0|1 --master IP
#   scripts/backends/use-model.sh             --profile <name>   (on the rig)
#
# A profile is DATA: it is parsed, never sourced or executed. KEY=VALUE per
# line; one layer of matching quotes is stripped; `  # comment` after an
# unquoted value is ignored (quote a value that itself contains " #"). An
# unknown key, a key set twice, or a line that is not KEY=VALUE is an ERROR —
# a typo must not quietly serve something else. Host/network settings (image
# digests, interfaces, ports, the API key file, MODELS_DIR) do NOT go here:
# they are spark.env's.
#
# Keys (empty = the engine's own default unless marked required):

# vllm | tensorfold. Required. A launcher refuses the other backend's profile.
BACKEND=vllm

# Required. A Hugging Face repo id (owner/name) or an ABSOLUTE local directory.
SOURCE=owner/model-name

# The commit to serve, as the full 40-hex SHA. Required for a Hub SOURCE; a
# branch or tag ("main", "v1") is refused because it can be re-pointed under
# you. model-inspect.sh prints the SHA it resolved; or
#   curl -s https://huggingface.co/api/models/<owner/name>/revision/main | jq -r .sha
REVISION=

# Required. The model id /v1/models lists and clients send.
SERVED_MODEL_NAME=

# 1 = one Spark; 2 = both Sparks, one rank each (default 2).
TENSOR_PARALLEL_SIZE=2

# Context window (tokens). Empty = the checkpoint's max_position_embeddings.
# vLLM --max-model-len / TensorFold --context. model-inspect.sh estimates what
# fits after the weights.
MAX_MODEL_LEN=

# ── vLLM only (a tensorfold profile that sets these is refused) ─────────────
# --dtype: auto | bfloat16 | float16 | float32
DTYPE=
# --quantization; empty = read the checkpoint's quantization_config (right
# for NVFP4/FP8/AWQ/GPTQ/compressed-tensors checkpoints).
QUANTIZATION=
# --tool-call-parser (with --enable-auto-tool-choice). OpenBeast's tools need
# one. model-inspect.sh suggests it from the chat template's markers;
# conformance.sh proves it.
TOOL_CALL_PARSER=
# --reasoning-parser. Empty = thinking stays inline in content.
REASONING_PARSER=
# --chat-template override: a .jinja file, relative to THIS profile or
# absolute; mounted read-only into the container. Empty = the repo's own.
CHAT_TEMPLATE=
# --trust-remote-code runs Python shipped in the model repo, inside the
# container, with the GPU, the model files and the network. Refused unless
# TRUST_REMOTE_CODE_ACK equals REVISION: read the repo's *.py at that commit
# first; bumping REVISION voids the acknowledgement.
TRUST_REMOTE_CODE=
TRUST_REMOTE_CODE_ACK=
# Fraction of the 128 GB unified pool vLLM may take (default 0.80). The OS
# and page cache live in the same memory — above ~0.85 starves them.
GPU_MEMORY_UTILIZATION=
# Concurrent sequences; set the rig's INFERENCE_SLOTS to the same number.
MAX_NUM_SEQS=
# --speculative-config JSON object, e.g. {"method":"mtp","num_speculative_tokens":3}
SPECULATIVE_CONFIG=

# ── TensorFold only (a vllm profile that sets these is refused) ─────────────
# --parallel: auto (one request at a time on CUDA) or N.
TENSORFOLD_PARALLEL=
# A draft model, pinned and fetched like SOURCE. Empty = --drafter none.
DRAFTER_SOURCE=
DRAFTER_REVISION=

# ── Both ────────────────────────────────────────────────────────────────────
# Extra engine arguments as a JSON array of strings, e.g.
#   EXTRA_ARGS=["--enable-prefix-caching","--kv-cache-dtype","fp8"]
# Only flags on the engine's ALLOW list pass (data/<engine>.json
# extra_args_allow: performance, scheduling and logging knobs, checked
# against the flags that exist at the vendored engine commit). Spelling
# tricks do not help: "_" counts as "-", case is ignored, and a prefix of a
# refused flag is that flag. Short options (-tp) are refused.
EXTRA_ARGS=
# Any OTHER flag needs this set to REVISION ("I read what these flags do, for
# this commit"). Flags that put a secret on argv, re-pin the model or
# tokenizer, import code, or override what a key above / the launcher /
# spark.env owns (extra_args_never) are refused even then.
EXTRA_ARGS_ACK=

# model-fetch.sh file selection, JSON arrays of globs. Default: every file at
# REVISION except pickled weights (*.bin *.pt *.pth *.ckpt *.pkl), *.gguf,
# *.onnx, original/* and hidden paths. FETCH_INCLUDE replaces that selection.
FETCH_INCLUDE=
FETCH_EXCLUDE=
