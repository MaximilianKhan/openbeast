# OpenBeast — a DGX Spark cluster of 1 to 8 nodes (docs/SPARK_HYDRA.md,
# "Scaling: 1 to 8 Sparks"). Read by scripts/backends/spark-cluster.sh on the
# HEAD (rank 0). Parsed, never sourced: KEY=VALUE per line.
#
# Copy to scripts/backends/cluster.env on the head. Every node keeps its own
# scripts/backends/spark.env (its own interface / HCA / addresses); this file
# only says which nodes form the cluster and in what order.

# The nodes in RANK ORDER, space-separated: rank 0 first. `local` means this
# machine (the head); every other entry is an ssh target, best its address on
# the ConnectX fabric so control traffic never needs the LAN or the internet.
# 1 node: CLUSTER_NODES="local"
# 2 nodes, direct cable: CLUSTER_NODES="local max@10.100.216.2"
# 4 nodes on a switch: CLUSTER_NODES="local max@10.100.200.2 max@10.100.200.3 max@10.100.200.4"
CLUSTER_NODES="local"

# A name for the cluster (logs, status). The tailnet name of the pair here is
# spark-hydra; one box is never called that.
CLUSTER_NAME=spark-hydra

# Where the OpenBeast checkout lives on EVERY node (same path everywhere).
CLUSTER_REPO=~/openbeast
