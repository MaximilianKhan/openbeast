# OpenBeast — DGX Spark inference node settings (docs/DGX_SPARK_PLAN.md).
#
# HOST and NETWORK settings only — images, the ConnectX link, ports, the API
# key file, where models live. Used by the scripts that run ON THE SPARKS:
#   scripts/backends/vllm/spark-node.sh       --profile NAME --rank 0|1
#   scripts/backends/tensorfold/spark-node.sh --profile NAME --rank 0|1 --master <rank0-link-ip>
#   scripts/backends/model-fetch.sh           --profile NAME
#
# Copy to scripts/backends/spark.env on BOTH Sparks (or pass --env FILE) and
# keep the two copies identical except SPARK_NODE_IP. Parsed, never sourced:
# KEY=VALUE per line, one layer of matching quotes stripped, `# comment` after
# an unquoted value ignored, a leading ~ expanded. An environment variable of
# the same name overrides the file; a command-line flag overrides both.
#
# Every value marked VERIFY ON HARDWARE is a placeholder from the research
# notes, not something measured on a GB10.

# ── Images: pin tag AND digest ──────────────────────────────────────────────
# Run `docker pull <image>` once, then
#   docker inspect --format '{{index .RepoDigests 0}}' <image>
# and paste the sha256 here. The scripts refuse to RUN (--print still works)
# while a digest is the placeholder: a tag alone can be re-pushed under us.
# nvcr.io/nvidia/vllm:26.05-py3 is the two-Spark playbook's pin
# (github.com/NVIDIA/dgx-spark-playbooks nvidia/vllm); the upstream
# vllm/vllm-openai:cu130-nightly also runs on GB10 (vllm.ai blog 2026-06-01).
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05-py3
VLLM_IMAGE_DIGEST=sha256:REPLACE_WITH_PULLED_DIGEST
# TensorFold has no image: it pip-installs into NVIDIA's PyTorch container
# (TensorFold RUNBOOK.md "NVIDIA GPUs") at every container start. Pin it by
# COMMIT SHA — a tag can be moved, and it is Alpha (five releases in 36 hours
# around v0.3.7). The launcher refuses anything but 40 hex digits. Resolve a
# tag with: gh api repos/ashhart/TensorFold/git/ref/tags/<tag> (an annotated
# tag: follow .object to git/tags/<sha> for the commit).
TENSORFOLD_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
TENSORFOLD_IMAGE_DIGEST=sha256:REPLACE_WITH_PULLED_DIGEST
# v0.5.0 (tag object eeb67464…) -> commit. Keep it equal to the commit
# scripts/backends/data/tensorfold.json was vendored from (tests pin that):
# model-inspect's "TensorFold supports this" is only true for that code.
# v0.4.0+ reads GLM-5.3-Flash EXL3 and --min-p, and --reasoning-effort now
# defaults to the chat template's own (Qwen3.8: xhigh) instead of medium.
TENSORFOLD_REF=9cd52ab4daba68ddd09be89be8f23ad43175e821

# ── The ConnectX-7 link between the two Sparks ──────────────────────────────
# `ibdev2netdev` on each Spark shows the port that is Up, e.g.
#   rocep1s0f1 port 1 ==> enp1s0f1np1 (Up)
# The left name is the HCA, the right name the interface. VERIFY ON HARDWARE:
# guides show enp1s0f1np1, enp1s0f0np0 and enP2p1s0f1np1.
SPARK_IFACE=enp1s0f1np1
SPARK_IB_HCA=rocep1s0f1
# Rank 0's address ON THAT LINK (build.nvidia.com/spark/connect-two-sparks).
SPARK_HEAD_IP=192.168.100.10
# This node's own link address (only used for VLLM_HOST_IP).
SPARK_NODE_IP=192.168.100.10
# vLLM's torch.distributed rendezvous (native multi-node, --master-port).
VLLM_MASTER_PORT=29501
# TensorFold's rendezvous — UNAUTHENTICATED. Firewall it to the peer's link
# address (docs/DGX_SPARK_PLAN.md § Security).
TENSORFOLD_MASTER_PORT=29551

# ── The HTTP endpoint rank 0 serves (what the rig's INFERENCE_URL points at) ─
# A SPECIFIC address — this Spark's tailnet or private-LAN IP — never a
# wildcard: vLLM leaves /health and /metrics unauthenticated even with an API
# key, and TensorFold has no key at all. 0.0.0.0 / :: are refused unless
# SPARK_ALLOW_WILDCARD_BIND=true (then firewall it yourself).
SPARK_SERVE_HOST=
SPARK_SERVE_PORT=8000
SPARK_ALLOW_WILDCARD_BIND=false

# ── Models ──────────────────────────────────────────────────────────────────
# WHAT to serve is not set here: every per-model fact (repo, pinned revision,
# parsers, context, memory fraction, extra args) lives in a model profile,
# scripts/backends/models/<name>.env, passed as --profile NAME. See
# models/TEMPLATE.env and the onboarding runbook in docs/DGX_SPARK_PLAN.md.
# Optional default for --profile, so both ranks' commands stay symmetric:
SPARK_PROFILE=
# Where model-fetch.sh puts verified checkpoints (one directory per profile,
# mounted read-only into the containers). Needs room for the weights; the
# same path on both Sparks.
MODELS_DIR=~/openbeast-models
# A Hugging Face token for gated/private repos, in a file only you can read
# (chmod 600). Read by model-fetch.sh / model-inspect.sh; never on argv.
HF_TOKEN_FILE=
# Hugging Face cache on the Spark (mounted into the vLLM container; used only
# when a profile is served straight from the Hub instead of MODELS_DIR).
HF_CACHE=~/.cache/huggingface

# ── vLLM ────────────────────────────────────────────────────────────────────
# The API key, in a file only you can read (chmod 600). Created with e.g.
#   (umask 077; openssl rand -hex 32 > ~/.config/openbeast/vllm-api-key)
# It reaches vLLM through the VLLM_API_KEY environment variable (docker -e
# VLLM_API_KEY, value taken from the launching shell), never argv. Put the
# SAME key in the rig's LLAMA_API_KEY. SPARK_NO_API_KEY=true runs keyless —
# only on a link nobody else can reach.
VLLM_API_KEY_FILE=~/.config/openbeast/vllm-api-key
SPARK_NO_API_KEY=false
