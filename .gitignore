# Inference engine and model weights (large binaries)
llama.cpp/
weights/

# Local machine config (weights location, etc.) — never commit personal paths
openbeast.conf

# Secrets / environment files — never commit
.env
.env.*
*.env

# Agent logs
agents/logs/

# Python
__pycache__/
*.pyc

# Eval results (generated, not checked in)
evals/results/

# Caches
.cache/
.claude/
.pytest_cache/
.ruff_cache/
evals/cache/
.run/

# llama.cpp experiment worktrees
.wt-*/

# beast-lang L1 artifacts: generated from the INSTALLED toolchain in ~0.2s,
# so they are per-rig state, not source. The serving path probes live; these
# files exist only for review (./scripts/lang-introspect.sh write).
agents/lang/generated/

# Per-rig transfer artifacts, not source. The docs and every failure message
# tell an operator to run `./scripts/pydeps.sh wheelhouse wheels` or
# `./scripts/bundle.sh build ./bundle` FROM THE REPO ROOT, which without these
# lines drops 43+ untracked wheels (or a multi-GB bundle, images and weights
# included) into `git status` — and a hurried `git add -A` on a closed box
# would commit them. Everything here is regenerable from
# agents/requirements.lock, which IS source.
wheels/
wheelhouse/
bundle/
*.bundle/
