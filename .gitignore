# Inference engine and model weights (large binaries)
llama.cpp/
weights/

# Local machine config (weights location, etc.) — never commit personal paths
openbeast.conf

# Secrets / environment files — never commit
.env
.env.*
*.env
# …except model profiles: data files that cannot hold a secret (pylib/obprofile.py
# refuses any key outside its allow list, and none of those is a credential).
# Committing a profile + its .lock is the supply-chain pin for that model.
!scripts/backends/models/*.env
# …and Project Maya's profiles, for the same reason: scripts/engines/maya.sh
# refuses any key outside GGUF / SERVED_MODEL_NAME / CONTEXT /
# RAM_HEADROOM_GB / VRAM_RESERVE_MIB.
!scripts/engines/maya/profiles/*.env

# Agent logs
agents/logs/

# Python
__pycache__/
*.pyc

# Eval results (generated, not checked in)
evals/results/
# evals/campaign.py rerun-lost sub-manifests (temporary, per campaign)
evals/suites/_lost-*.json

# Caches
.cache/
.claude/
.pytest_cache/
.ruff_cache/
evals/cache/
# Contaminated cache rows a review moved aside (MANIFEST.txt inside): local data.
evals/cache-quarantine-*/
.run/

# llama.cpp experiment worktrees
.wt-*/

# beast-lang L1 artifacts: generated from the INSTALLED toolchain in ~0.2s,
# so they are per-rig state, not source. The serving path probes live; these
# files exist only for review (./scripts/lang-introspect.sh write).
agents/lang/generated/

# Per-rig transfer artifacts, not source. The docs and every failure message
# tell an operator to run `./scripts/pydeps.sh wheelhouse wheels` or
# `./scripts/bundle.sh build ./bundle` FROM THE REPO ROOT, which without these
# lines drops 43+ untracked wheels (or a multi-GB bundle, images and weights
# included) into `git status` — and a hurried `git add -A` on a closed box
# would commit them. Everything here is regenerable from
# agents/requirements.lock, which IS source.
wheels/
wheelhouse/
bundle/
*.bundle/

# scripts/bundle.sh install keeps the original compose file beside the one it
# rewrites to local image IDs — restore from it, never commit it.
docker-compose.yml.pre-bundle
extensions/*/compose.yaml.pre-bundle

# scratch/: the campaign tooling and verdict records ARE tracked (they produced
# the numbers in docs/RESULTS.md and resume the campaign). What is not: its
# runtime logs, editor/backup copies, and the clean llama.cpp build tree the
# serving/research separation audit uses (docs/RUNBOOK-2026-09-08.md).
scratch/logs/
scratch/**/*.pre-*
llamacpp-clean/

# beast-hydra routing config: names tailnet hosts (hydra.toml.example is tracked)
/hydra.toml

# instinct: shadow rows labelled from the ledger carry user text (0600);
# a human moves chosen rows into a dataset split — never commit this file.
evals/decisions/*/shadow-labelled.jsonl

# Engine plane state: pin history, conf backups, staged releases (scripts/engine.sh)
.engines/
