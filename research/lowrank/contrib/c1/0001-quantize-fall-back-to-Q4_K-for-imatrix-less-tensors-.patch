From f76b99fb2351d6e3320f4fe4e2e447a5464f578e Mon Sep 17 00:00:00 2001
From: Max <maxjkh@gmail.com>
Date: Fri, 11 Sep 2026 10:58:10 -0700
Subject: [PATCH 1/2] quantize : fall back to Q4_K for imatrix-less tensors
 instead of failing

Tensors that the graph never runs during imatrix collection (e.g. NextN/MTP
layers) have no imatrix entry, so very low-bit types failed with "Missing
importance matrix". Use Q4_K for those tensors, warn once per tensor and
print a summary count. Without --imatrix the existing error is unchanged.

Assisted-by: Claude Fable 5.1
---
 src/llama-quant.cpp | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/src/llama-quant.cpp b/src/llama-quant.cpp
index 34ff25d..16c6e1d 100644
--- a/src/llama-quant.cpp
+++ b/src/llama-quant.cpp
@@ -177,7 +177,8 @@ struct quantize_state_impl {
     int i_ffn_gate     = 0;
     int i_ffn_up       = 0;
 
-    int n_fallback    = 0;
+    int n_fallback         = 0;
+    int n_fallback_imatrix = 0;
 
     bool has_imatrix = false;
 
@@ -1096,6 +1097,17 @@ static void llama_model_quantize_impl(const std::string & fname_inp, const std::
 
         if (params->imatrix) {
             metadata[i].remapped_imatrix_name = remap_imatrix(tensor->name, mapped);
+
+            // tensors that the graph never runs during imatrix collection (e.g. NextN/MTP layers) have no entry
+            // Q4_K needs no imatrix and is what the low-bit mixes already use for their most sensitive tensors
+            if (metadata[i].requires_imatrix && imatrix_data->find(metadata[i].remapped_imatrix_name) == imatrix_data->end()) {
+                const ggml_type type_fallback = tensor_type_fallback(qs, tensor, GGML_TYPE_Q4_K);
+                LLAMA_LOG_WARN("%s: %-36s - no imatrix data, using %s instead of %s\n",
+                               __func__, tensor->name, ggml_type_name(type_fallback), ggml_type_name(metadata[i].target_type));
+                metadata[i].target_type      = type_fallback;
+                metadata[i].requires_imatrix = false;
+                ++qs.n_fallback_imatrix;
+            }
         } else if (metadata[i].allows_quantization && metadata[i].requires_imatrix) {
             if (params->dry_run) {
                 will_require_imatrix = true;
@@ -1356,6 +1368,11 @@ static void llama_model_quantize_impl(const std::string & fname_inp, const std::
         LLAMA_LOG_WARN("%s: WARNING: %d of %d tensor(s) required fallback quantization\n",
                 __func__, qs.n_fallback, ml.n_tensors);
     }
+
+    if (qs.n_fallback_imatrix > 0) {
+        LLAMA_LOG_WARN("%s: WARNING: %d tensor(s) had no imatrix data and were quantized with a fallback type\n",
+                __func__, qs.n_fallback_imatrix);
+    }
 }
 
