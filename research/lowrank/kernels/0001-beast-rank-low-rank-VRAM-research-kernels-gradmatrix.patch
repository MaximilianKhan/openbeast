+++ b/tools/gradmatrix/gradmatrix.cpp
@@ -0,0 +1,418 @@
+// LOCAL RESEARCH PATCH (beast-rank E20, not for upstream):
+// collect output-gradient Grams T = sum_t g g^T per weight tensor, where
+// g = dLoss/d(pre-activation output row) of the tensor's mul_mat.
+//
+// Method: run forward+backward via llama_opt_epoch with learning disabled
+// (SGD, alpha = 0, wd = 0). In the backward graph, the input-gradient of
+// each mul_mat(W, x) is built as out_prod(W, transpose(G)) where G is the
+// output gradient [n_out, n_tokens] (see ggml_compute_backward, MUL_MAT).
+// We hook the sched eval callback on those OUT_PROD nodes; src[0] carries
+// the weight name, src[1]->src[0] is G. This works with quantized weights,
+// which cannot be params (llama_set_param is F32-only) - gradient flow is
+// kept alive by the F32 norm weights, which are params in every layer.
+//
+// Env (mirrors the imatrix Gram patch):
+//   LLAMA_GRADMATRIX_DIR    - output dir (required)
+//   LLAMA_GRADMATRIX_CHUNKS - number of n_ctx windows to process (default 32)
+//   LLAMA_GRADMATRIX_MAXDIM - block 8x above this dim (default 8192)
+
+#include "arg.h"
+#include "common.h"
+#include "log.h"
+#include "llama.h"
+
+#include <cinttypes>
+#include <clocale>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#if defined(_MSC_VER)
+#pragma warning(disable: 4244 4267)  // possible loss of data
+#endif
+
+struct GradGramStats {
+    std::vector<float> g;      // n*n, or n_blocks*(bs*bs) when blocked
+    int64_t n       = 0;
+    int64_t blocks  = 1;
+    int64_t count   = 0;       // accumulated tokens
+};
+
+class GradGramCollector {
+public:
+    bool collect(struct ggml_tensor * t, bool ask);
+    int64_t save() const; // returns number of Gram files written
+    int64_t n_tensors() const { return (int64_t) m_grams.size(); }
+private:
+    void accumulate(const std::string & wname, const struct ggml_tensor * G, const char * data);
+    std::mutex m_mutex;
+    std::unordered_map<std::string, GradGramStats> m_grams;
+    std::vector<float> m_g;    // packed token buffer
+    std::vector<char>  m_host; // host copy of G
+};
+
+static GradGramCollector g_collector;
+
+static const char * gradgram_dir() {
+    return getenv("LLAMA_GRADMATRIX_DIR");
+}
+
+static int64_t gradgram_maxdim() {
+    const char * s = getenv("LLAMA_GRADMATRIX_MAXDIM");
+    return s ? atoll(s) : 8192;
+}
+
+static int64_t gradgram_chunks() {
+    const char * s = getenv("LLAMA_GRADMATRIX_CHUNKS");
+    return s ? atoll(s) : 32;
+}
+
+// unlike the input-side Grams (shared input group), every projection has a
+// distinct output, so one Gram per tensor kind; blk. prefix excludes the
+// vocab-sized output.weight.
+// hybrid (delta-net) layers: ssm_out and attn_gate sit above the gradient
+// cut and get exact G; attn_qkv/ssm_alpha/ssm_beta only feed cut ops, their
+// G would be all-zero, so they are not collected.
+static bool gradgram_wanted(const std::string & wname) {
+    if (wname.compare(0, 4, "blk.") != 0) {
+        return false;
+    }
+    return wname.find("attn_q.weight")      != std::string::npos ||
+           wname.find("attn_k.weight")      != std::string::npos ||
+           wname.find("attn_v.weight")      != std::string::npos ||
+           wname.find("attn_output.weight") != std::string::npos ||
+           wname.find("ffn_gate.weight")    != std::string::npos ||
+           wname.find("ffn_up.weight")      != std::string::npos ||
+           wname.find("ffn_down.weight")    != std::string::npos ||
+           wname.find("ssm_out.weight")     != std::string::npos ||
+           wname.find("attn_gate.weight")   != std::string::npos;
+}
+
+// remove any prefix and suffixes from the name
+// CUDA0#blk.0.attn_k.weight#0 => blk.0.attn_k.weight
+static std::string filter_tensor_name(const char * name) {
+    std::string wname;
+    const char * p = strchr(name, '#');
+    if (p != NULL) {
+        p = p + 1;
+        const char * q = strchr(p, '#');
+        if (q != NULL) {
+            wname = std::string(p, q - p);
+        } else {
+            wname = p;
+        }
+    } else {
+        wname = name;
+    }
+    return wname;
+}
+
+bool GradGramCollector::collect(struct ggml_tensor * t, bool ask) {
+    if (t->op != GGML_OP_OUT_PROD) {
+        return false;
+    }
+    const struct ggml_tensor * src0 = t->src[0];
+    const struct ggml_tensor * src1 = t->src[1];
+    if (!src0 || !src1) {
+        return false;
+    }
+    const std::string wname = filter_tensor_name(src0->name);
+    if (!gradgram_wanted(wname)) {
+        return false;
+    }
+    // dx = out_prod(W, transpose(G)); the other OUT_PROD (dW = out_prod(x, G))
+    // has an activation as src0 and never matches a .weight name
+    if (src1->op != GGML_OP_TRANSPOSE || !src1->src[0]) {
+        return false;
+    }
+    const struct ggml_tensor * G = src1->src[0];
+    if (G->ne[0] != src0->ne[1] || G->ne[2] != 1 || G->ne[3] != 1) {
+        return false;
+    }
+    if (ask) {
+        return true;
+    }
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+
+    if (!G->buffer) {
+        LOG_WRN("%s: %s: gradient tensor '%s' (op %s) has no buffer - skipping\n",
+                __func__, wname.c_str(), G->name, ggml_op_name(G->op));
+        return true;
+    }
+
+    const bool is_host = ggml_backend_buffer_is_host(G->buffer);
+    if (!is_host) {
+        m_host.resize(ggml_nbytes(G));
+        ggml_backend_tensor_get(G, m_host.data(), 0, ggml_nbytes(G));
+    }
+    const char * data = is_host ? (const char *) G->data : m_host.data();
+    GGML_ASSERT(G->nb[0] == ggml_element_size(G));
+    GGML_ASSERT(G->type == GGML_TYPE_F32);
+
+    accumulate(wname, G, data);
+
+    return true;
+}
+
+void GradGramCollector::accumulate(const std::string & wname, const struct ggml_tensor * G, const char * data) {
+    const int64_t n = G->ne[0];
+    const int64_t blocks = n > gradgram_maxdim() ? 8 : 1;
+    if (n % blocks != 0) {
+        return;
+    }
+    auto & gs = m_grams[wname];
+    if (gs.g.empty()) {
+        gs.n = n;
+        gs.blocks = blocks;
+        const int64_t bs = n / blocks;
+        gs.g.assign((size_t)(blocks * bs * bs), 0.0f);
+    }
+    if (gs.n != n) {
+        return;
+    }
+
+    const int64_t T = G->ne[1];
+    m_g.resize((size_t)(T * n));
+    for (int64_t row = 0; row < T; ++row) {
+        memcpy(m_g.data() + (size_t) row * n, data + row * G->nb[1], n * sizeof(float));
+    }
+    gs.count += T;
+
+    const int64_t bs = gs.n / gs.blocks;
+    const int nth = std::max(1u, std::min(32u, std::thread::hardware_concurrency()));
+    for (int64_t b = 0; b < gs.blocks; ++b) {
+        float * Gm = gs.g.data() + (size_t)(b * bs * bs);
+        const int64_t off = b * bs;
+        std::vector<std::thread> th;
+        for (int ti = 0; ti < nth; ++ti) {
+            th.emplace_back([&, ti]() {
+                for (int64_t i = ti; i < bs; i += nth) {
+                    float * grow = Gm + (size_t) i * bs;
+                    for (int64_t t = 0; t < T; ++t) {
+                        const float * x = m_g.data() + (size_t) t * n + off;
+                        const float xi = x[i];
+                        if (xi == 0.0f) {
+                            continue;
+                        }
+                        for (int64_t j = 0; j < bs; ++j) {
+                            grow[j] += xi * x[j];
+                        }
+                    }
+                }
+            });
+        }
+        for (auto & t : th) {
+            t.join();
+        }
+    }
+}
+
+int64_t GradGramCollector::save() const {
+    const char * dir = gradgram_dir();
+    if (!dir || m_grams.empty()) {
+        return 0;
+    }
+    int64_t n_written = 0;
+    std::string manifest = "{";
+    bool first = true;
+    for (const auto & kv : m_grams) {
+        bool all_zero = true;
+        for (float v : kv.second.g) {
+            if (v != 0.0f) {
+                all_zero = false;
+                break;
+            }
+        }
+        if (all_zero) {
+            LOG_WRN("%s: %s accumulated an all-zero Gram (disconnected gradient path?) - writing anyway\n", __func__, kv.first.c_str());
+        }
+        std::string fn = kv.first;
+        for (auto & c : fn) {
+            if (c == '/') c = '_';
+        }
+        std::string path = std::string(dir) + "/" + fn + ".gradgram.bin";
+        FILE * f = fopen(path.c_str(), "wb");
+        if (!f) {
+            LOG_ERR("%s: cannot write %s\n", __func__, path.c_str());
+            continue;
+        }
+        fwrite(kv.second.g.data(), sizeof(float), kv.second.g.size(), f);
+        fclose(f);
+        n_written++;
+        if (!first) {
+            manifest += ",";
+        }
+        first = false;
+        manifest += "\"" + kv.first + "\":{\"n\":" + std::to_string(kv.second.n) +
+                    ",\"blocks\":" + std::to_string(kv.second.blocks) +
+                    ",\"count\":" + std::to_string(kv.second.count) + "}";
+    }
+    manifest += "}";
+    std::string mpath = std::string(dir) + "/gradgrams.json";
+    FILE * f = fopen(mpath.c_str(), "wb");
+    if (!f) {
+        LOG_ERR("%s: cannot write %s\n", __func__, mpath.c_str());
+        return 0;
+    }
+    fwrite(manifest.data(), 1, manifest.size(), f);
+    fclose(f);
+    LOG_INF("%s: wrote %" PRId64 " grad Grams + gradgrams.json to %s\n", __func__, n_written, dir);
+    return n_written;
+}
+
+static bool cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+    GradGramCollector * c = (GradGramCollector *) user_data;
+    return c->collect(t, ask);
+}
+
+// learning disabled: ggml-opt asserts alpha > 0, but 1e-30f makes the SGD
+// update w - alpha*g round to exactly w in fp32 (relative change < 2^-24)
+static ggml_opt_optimizer_params zero_lr_pars(void * userdata) {
+    GGML_UNUSED(userdata);
+    ggml_opt_optimizer_params p = ggml_opt_get_default_optimizer_params(nullptr);
+    p.sgd.alpha   = 1e-30f;
+    p.sgd.wd      = 0.0f;
+    p.adamw.alpha = 1e-30f;
+    p.adamw.wd    = 0.0f;
+    return p;
+}
+
+static void print_usage(int, char ** argv) {
+    LOG("\nexample usage:\n");
+    LOG("\n    LLAMA_GRADMATRIX_DIR=./out %s -m model.gguf -f calib.txt -c 512 -b 512 -ub 512\n", argv[0]);
+    LOG("\n");
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    common_params params;
+    params.escape = false;
+
+    common_init();
+
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_FINETUNE, print_usage)) {
+        return 1;
+    }
+
+    if (!gradgram_dir()) {
+        LOG_ERR("%s: LLAMA_GRADMATRIX_DIR is not set\n", __func__);
+        return 1;
+    }
+    {
+        // fail fast if the output dir is missing or not writable
+        std::string probe = std::string(gradgram_dir()) + "/.gradgram.probe";
+        FILE * f = fopen(probe.c_str(), "wb");
+        if (!f) {
+            LOG_ERR("%s: LLAMA_GRADMATRIX_DIR '%s' is not writable\n", __func__, gradgram_dir());
+            return 1;
+        }
+        fclose(f);
+        remove(probe.c_str());
+    }
+
+    if (params.load_mode != LLAMA_LOAD_MODE_NONE) {
+        LOG_INF("%s: forcing load_mode = none to enable writable pointers to the weights\n", __func__);
+        params.load_mode = LLAMA_LOAD_MODE_NONE;
+    }
+    if (params.cache_type_k != GGML_TYPE_F32) {
+        LOG_INF("%s: force changing k cache type to f32 due to a lack of f16 support for OUT_PROD\n", __func__);
+        params.cache_type_k = GGML_TYPE_F32;
+    }
+    if (params.cache_type_v != GGML_TYPE_F32) {
+        LOG_INF("%s: force changing v cache type to f32 due to a lack of f16 support for OUT_PROD\n", __func__);
+        params.cache_type_v = GGML_TYPE_F32;
+    }
+    // FLASH_ATTN_EXT has no backward pass
+    params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    // the warmup decode arms the sched eval callback before the opt path runs
+    params.warmup = true;
+
+    params.cb_eval           = cb_eval;
+    params.cb_eval_user_data = &g_collector;
+
+    llama_backend_init();
+    llama_numa_init(params.numa);
+
+    auto llama_init = common_init_from_params(params);
+
+    auto * model = llama_init->model();
+    auto * ctx   = llama_init->context();
+
+    if (model == NULL) {
+        LOG_ERR("%s: unable to load model\n", __func__);
+        return 1;
+    }
+
+    {
+        LOG_INF("\n");
+        LOG_INF("%s\n", common_params_get_system_info(params).c_str());
+    }
+
+    std::vector<llama_token> tokens = common_tokenize(ctx, params.prompt, true);
+    const int64_t n_ctx = llama_n_ctx(ctx);
+
+    // non-overlapping windows so each token contributes exactly one gradient
+    const int64_t n_chunks = gradgram_chunks();
+    const size_t n_keep = (size_t)(n_chunks * n_ctx + n_ctx + 2);
+    if (tokens.size() > n_keep) {
+        tokens.resize(n_keep);
+    }
+    if ((int64_t) tokens.size() < 2*n_ctx) {
+        LOG_ERR("%s: need at least %" PRId64 " tokens, got %zu\n", __func__, 2*n_ctx, tokens.size());
+        return 1;
+    }
+    ggml_opt_dataset_t dataset = common_opt_dataset_init(ctx, tokens, /*stride =*/ n_ctx);
+
+    struct llama_opt_params lopt_params {
+        /*n_ctx_train     =*/ 0,
+        /*param_filter    =*/ llama_opt_param_filter_all,
+        /*param_filter_ud =*/ nullptr,
+        /*get_opt_pars    =*/ zero_lr_pars,
+        /*get_opt_pars_ud =*/ nullptr,
+        /*optimizer_type  =*/ GGML_OPT_OPTIMIZER_TYPE_SGD,
+    };
+    llama_opt_init(ctx, model, lopt_params);
+
+    // all windows go through the train split: backward runs, lr = 0 keeps the weights fixed
+    const int64_t idata_split = ggml_opt_dataset_ndata(dataset);
+    LOG_INF("%s: %" PRId64 " windows of %" PRId64 " tokens, backward pass with lr = 0\n", __func__, idata_split, n_ctx);
+
+    ggml_opt_result_t result_train = ggml_opt_result_init();
+    ggml_opt_result_t result_eval  = ggml_opt_result_init();
+
+    llama_opt_epoch(ctx, dataset, result_train, result_eval, idata_split,
+                    ggml_opt_epoch_callback_progress_bar, ggml_opt_epoch_callback_progress_bar);
+    fprintf(stderr, "\n");
+
+    {
+        double loss, unc;
+        int64_t ndata;
+        ggml_opt_result_ndata(result_train, &ndata);
+        ggml_opt_result_loss(result_train, &loss, &unc);
+        LOG_INF("%s: ndata = %" PRId64 ", mean loss per token = %.6f +- %.6f\n", __func__, ndata, loss, unc);
+    }
+
+    ggml_opt_result_free(result_train);
+    ggml_opt_result_free(result_eval);
+
+    if (g_collector.n_tensors() == 0) {
+        LOG_ERR("%s: no gradient Grams were collected - callback did not fire\n", __func__);
+        return 1;
+    }
+    if (g_collector.save() == 0) {
+        LOG_ERR("%s: no gradient Gram files were written to %s\n", __func__, gradgram_dir());
+        return 1;
+    }
+
+    llama_backend_free();
+
+    return 0;
+}
