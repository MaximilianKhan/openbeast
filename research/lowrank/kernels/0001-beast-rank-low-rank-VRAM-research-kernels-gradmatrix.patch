+// LOCAL RESEARCH PATCH (beast-rank E10/E23)
+GramStats * IMatrixCollector::gram_get(const std::string & wname, int64_t n) {
+    const int64_t blocks = n > gram_maxdim() ? 8 : 1;
+    if (n % blocks != 0) {
+        return nullptr;
+    }
+    auto & gs = m_grams[wname];
+    if (gs.g.empty()) {
+        gs.n = n;
+        gs.blocks = blocks;
+        const int64_t bs = n / blocks;
+        gs.g.assign((size_t)(blocks * bs * bs), 0.0f);
+    }
+    return gs.n == n ? &gs : nullptr;
+}
+
+void IMatrixCollector::gram_accumulate(const std::string & wname, const struct ggml_tensor * src1, const char * data) {
+    const int64_t n = src1->ne[0];
+    GramStats * gs = gram_get(wname, n);
+    if (!gs) {
+        return;
+    }
+
+    // pack tokens contiguous: rows of all i3/i2 slices
+    const int64_t T = ggml_nrows(src1);
+    m_gram_x.resize((size_t)(T * n));
+    int64_t tt = 0;
+    for (int64_t i3 = 0; i3 < src1->ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < src1->ne[2]; ++i2) {
+            for (int64_t row = 0; row < src1->ne[1]; ++row) {
+                const float * x = (const float *) (data + row * src1->nb[1] + i2 * src1->nb[2] + i3 * src1->nb[3]);
+                memcpy(m_gram_x.data() + (size_t) tt * n, x, n * sizeof(float));
+                tt++;
+            }
+        }
+    }
+    gram_update(*gs, T);
+}
+
+// pooled Gram for MoE expert stacks: one Gram per stack input over all routed
+// (token, slot) pairs, matching the per-pair accumulation of the imatrix sums.
+// experts share the input space, so a single pooled basis serves all of them.
+void IMatrixCollector::gram_accumulate_id(const std::string & wname, const struct ggml_tensor * src1, const char * data, int64_t n_ids) {
+    if (src1->type != GGML_TYPE_F32) {
+        return;
+    }
+    const int64_t n = src1->ne[0];
+    GramStats * gs = gram_get(wname, n);
+    if (!gs) {
+        return;
+    }
+
+    // src1 is [n, ne1, n_tokens]; ne1 == 1 broadcasts one row to all slots
+    const int64_t T = n_ids * src1->ne[2];
+    m_gram_x.resize((size_t)(T * n));
+    int64_t tt = 0;
+    for (int64_t row = 0; row < src1->ne[2]; ++row) {
+        for (int64_t idx = 0; idx < n_ids; ++idx) {
+            const int64_t i11 = idx % src1->ne[1];
+            const float * x = (const float *) (data + i11 * src1->nb[1] + row * src1->nb[2]);
+            memcpy(m_gram_x.data() + (size_t) tt * n, x, n * sizeof(float));
+            tt++;
+        }
+    }
+    gram_update(*gs, T);
+}
+
+void IMatrixCollector::gram_update(GramStats & gs, int64_t T) {
+    gs.count += T;
+
+    const int64_t n = gs.n;
+    const int64_t bs = gs.n / gs.blocks;
+    const int nth = std::max(1u, std::min(32u, std::thread::hardware_concurrency()));
+    for (int64_t b = 0; b < gs.blocks; ++b) {
+        float * G = gs.g.data() + (size_t)(b * bs * bs);
+        const int64_t off = b * bs;
+        std::vector<std::thread> th;
+        for (int ti = 0; ti < nth; ++ti) {
+            th.emplace_back([&, ti]() {
+                for (int64_t i = ti; i < bs; i += nth) {
+                    float * grow = G + (size_t) i * bs;
+                    for (int64_t t = 0; t < T; ++t) {
+                        const float * x = m_gram_x.data() + (size_t) t * n + off;
+                        const float xi = x[i];
+                        if (xi == 0.0f) {
+                            continue;
+                        }
+                        for (int64_t j = 0; j < bs; ++j) {
+                            grow[j] += xi * x[j];
+                        }
+                    }
+                }
+            });
+        }
+        for (auto & t : th) {
+            t.join();
+        }
+    }
+}
+
+void IMatrixCollector::gram_save() const {
+    const char * dir = gram_dir();
+    if (!dir) {
+        return;
+    }
+    m_gram_written = 0;
+    if (m_grams.empty()) {
+        return;
+    }
+    std::string manifest = "{";
+    bool first = true;
+    for (const auto & kv : m_grams) {
+        std::string fn = kv.first;
+        for (auto & c : fn) {
+            if (c == '/') c = '_';
+        }
+        std::string path = std::string(dir) + "/" + fn + ".gram.bin";
+        FILE * f = fopen(path.c_str(), "wb");
+        if (!f) {
+            LOG_ERR("%s: cannot write %s\n", __func__, path.c_str());
+            continue;
+        }
+        const size_t nw = fwrite(kv.second.g.data(), sizeof(float), kv.second.g.size(), f);
+        fclose(f);
+        if (nw != kv.second.g.size()) {
+            LOG_ERR("%s: short write on %s\n", __func__, path.c_str());
+            continue;
+        }
+        m_gram_written++;
+        if (!first) {
+            manifest += ",";
+        }
+        first = false;
+        manifest += "\"" + kv.first + "\":{\"n\":" + std::to_string(kv.second.n) +
+                    ",\"blocks\":" + std::to_string(kv.second.blocks) +
+                    ",\"count\":" + std::to_string(kv.second.count) + "}";
+    }
+    manifest += "}";
+    std::string mpath = std::string(dir) + "/grams.json";
+    FILE * f = fopen(mpath.c_str(), "wb");
+    if (f) {
+        fwrite(manifest.data(), 1, manifest.size(), f);
+        fclose(f);
+    } else {
+        // consumers need the manifest, so a missing one voids the capture
+        LOG_ERR("%s: cannot write %s\n", __func__, mpath.c_str());
+        m_gram_written = 0;
+    }
+}
