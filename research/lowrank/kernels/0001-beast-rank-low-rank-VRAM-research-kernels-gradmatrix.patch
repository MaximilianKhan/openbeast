@@ -4275,12 +4373,15 @@ static void ggml_backend_cuda_graph_optimize(ggml_backend_t backend, ggml_cgraph
 
     const int min_fan_out = 3;
     const int max_fan_out = 3;
+    // with a lora adapter each q/k/v projection contributes 2 consumers of attn_norm
+    // (the base mul_mat and the lora A matvec); they pair into one branch per window
+    const int lora_fan_out = 2*max_fan_out;
 
     // store {fork_idx, join_idx}
     std::vector<std::pair<int, int>> concurrent_node_ranges;
 
     for (const auto & [root_node, count] : fan_out) {
-        if (count >= min_fan_out && count <= max_fan_out) {
+        if ((count >= min_fan_out && count <= max_fan_out) || count == lora_fan_out) {
             const int root_node_idx = node_indices[root_node];
 
             // only optimize for attn_norm
@@ -4301,14 +4402,34 @@ static void ggml_backend_cuda_graph_optimize(ggml_backend_t backend, ggml_cgraph
             }
 
             std::vector<std::vector<const ggml_tensor *>> nodes_per_branch;
+            size_t n_seeds = 0;
             for (int i = root_node_idx + 1; i < cgraph->n_nodes; ++i) {
