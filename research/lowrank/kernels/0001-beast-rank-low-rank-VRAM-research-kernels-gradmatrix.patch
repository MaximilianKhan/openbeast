diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index d27d8acb1..3941dd7e4 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1532,6 +1532,12 @@ struct ggml_cuda_mm_fusion_args_host {
     const ggml_tensor * x_scale = nullptr;
     const ggml_tensor * gate_scale = nullptr;
     ggml_glu_op glu_op;
+    // lora epilogue: dst += lora_scale * (lora_b @ lora_t), lora_t = lora_a @ x
+    // lora_a set: t is produced inside the activation-quantize launch; else t is precomputed
+    const ggml_tensor * lora_a = nullptr; // [ncols_x, rank], F16, F32 or Q8_0
+    const ggml_tensor * lora_b = nullptr; // [rank, nrows_dst], F16, F32 or Q8_0
+    const ggml_tensor * lora_t = nullptr; // [rank, 1], F32
+    float lora_scale = 0.0f;
 };
 struct ggml_cuda_mm_fusion_args_device {
     const void * x_bias = nullptr;
@@ -1540,8 +1546,29 @@ struct ggml_cuda_mm_fusion_args_device {
     const void * x_scale = nullptr;
     const void * gate_scale = nullptr;
     ggml_glu_op glu_op;
+    const void * lora_b = nullptr;
+    const float * lora_t = nullptr;
+    // q8 sidecar of t (quantized alongside t in the activation-quantize launch):
+    // per-8-component scales + int8 quants; set => the Q8_0-B epilogue runs as an
+    // int8 dp4a dot against these instead of a float dot against lora_t
+    const float * lora_t_sc = nullptr;
+    const int8_t * lora_t_qs = nullptr;
+    float lora_scale = 0.0f;
+    uint32_t lora_rank = 0;
+    int lora_b_fmt = 0; // GGML_CUDA_LORA_FMT_*
 };
 
+// element storage of the lora adapter factors
+enum ggml_cuda_lora_fmt : int {
+    GGML_CUDA_LORA_FMT_F32  = 0,
+    GGML_CUDA_LORA_FMT_F16  = 1,
+    GGML_CUDA_LORA_FMT_Q8_0 = 2,
+};
+
+// scale-group width of the quantized-t sidecar: the 8 rank components one trailing
+// quantize block computes share one scale (finer than q8_1's 32, no cross-block sync)
+#define GGML_CUDA_LORA_TQ_GROUP 8
+
 struct ggml_cuda_kernel_launch_params {
     dim3 block_nums;
     dim3 block_dims;
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 561ab7ac5..238bf8356 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3688,6 +3688,101 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         return fused_node_count - 1;
     }
 
+    // lora branch at batch 1: mul_mat(W,x) + mul_mat(A,x) + mul_mat(B,t) + scale + add
+    // t = A@x stays a separate small kernel, B@t + scale + add ride the mmvq epilogue
+    static bool disable_lora_fusion = getenv("GGML_CUDA_DISABLE_LORA_FUSION") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_LORA_FUSION"));
+    if (!disable_lora_fusion) {
+        const ggml_op lora_ops[5] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_SCALE, GGML_OP_ADD };
+        const int lora_out[1] = { i + 4 };
+
+        if (ggml_can_fuse_subgraph(cgraph, i, 5, lora_ops, lora_out, 1) &&
+                ggml_cuda_check_fusion_memory_ranges(cgraph, i, 5, lora_out, 1)) {
+            ggml_tensor * mm_node    = cgraph->nodes[i];
+            ggml_tensor * mm_a_node  = cgraph->nodes[i + 1];
+            ggml_tensor * mm_b_node  = cgraph->nodes[i + 2];
+            ggml_tensor * scale_node = cgraph->nodes[i + 3];
+            ggml_tensor * add_node   = cgraph->nodes[i + 4];
+
+            const ggml_tensor * lora_a = mm_a_node->src[0];
+            const ggml_tensor * lora_b = mm_b_node->src[0];
+
+            const bool edges_ok =
+                mm_a_node->src[1]  == mm_node->src[1] &&
+                mm_b_node->src[1]  == mm_a_node       &&
+                scale_node->src[0] == mm_b_node       &&
+                ((add_node->src[0] == mm_node && add_node->src[1] == scale_node) ||
+                 (add_node->src[0] == scale_node && add_node->src[1] == mm_node)) &&
+                ggml_are_same_shape(add_node->src[0], add_node->src[1]);
+
+            const bool factors_ok = edges_ok &&
+                (lora_a->type == GGML_TYPE_F16 || lora_a->type == GGML_TYPE_F32 || lora_a->type == GGML_TYPE_Q8_0) &&
+                (lora_b->type == GGML_TYPE_F16 || lora_b->type == GGML_TYPE_F32 || lora_b->type == GGML_TYPE_Q8_0) &&
+                ggml_is_contiguous(lora_a) && ggml_is_contiguous(lora_b) &&
+                mm_a_node->type == GGML_TYPE_F32   &&
+                lora_a->ne[1] == lora_b->ne[0]     &&
+                lora_b->ne[0] <= 1024              &&
+                lora_a->ne[0] == mm_node->src[0]->ne[0] &&
+                lora_b->ne[1] == mm_node->src[0]->ne[1] &&
+                lora_a->ne[2] == 1 && lora_a->ne[3] == 1 &&
+                lora_b->ne[2] == 1 && lora_b->ne[3] == 1 &&
+                mm_node->ne[2] == 1 && mm_node->ne[3] == 1;
+
+            // Q8_0 factors: unfused B@t already runs as an int8 dp4a kernel, so the
+            // float-epilogue fused path only pays off when dst_rows x rank is small
+            // (launch-bound regime) — that keeps the Phase-2B NR gate. Windows that will
+            // take the quantized-t dp4a epilogue (mirrors the mmvq host decision: Q8_0 B,
+            // rank multiple of the sidecar group, nrows >= GGML_CUDA_LORA_TQ_MIN_ROWS)
+            // match the unfused kernel's integer path per row and fuse unconditionally.
+            static bool disable_lora_tq = getenv("GGML_CUDA_DISABLE_LORA_TQ") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_LORA_TQ"));
+            static int64_t lora_tq_min_rows = getenv("GGML_CUDA_LORA_TQ_MIN_ROWS") ?
+                atoll(getenv("GGML_CUDA_LORA_TQ_MIN_ROWS")) : 4096;
+            static int64_t lora_q8_max_nr = getenv("GGML_CUDA_LORA_FUSION_Q8_MAX_NR") ?
+                atoll(getenv("GGML_CUDA_LORA_FUSION_Q8_MAX_NR")) : 448*1024;
+            const bool window_tq = !disable_lora_tq && lora_b->type == GGML_TYPE_Q8_0 &&
+                lora_b->ne[0] % GGML_CUDA_LORA_TQ_GROUP == 0 && lora_b->ne[1] >= lora_tq_min_rows;
+            const bool size_ok = factors_ok &&
+                ((lora_a->type != GGML_TYPE_Q8_0 && lora_b->type != GGML_TYPE_Q8_0) ||
+                 window_tq ||
+                 lora_b->ne[1]*lora_b->ne[0] <= lora_q8_max_nr);
+
+            // t stays live as an input of the fused kernel, so it must not alias the fused dst
+            const bool no_alias = size_ok &&
+                ((const char *) add_node->data + ggml_nbytes(add_node) <= (const char *) mm_a_node->data ||
+                 (const char *) mm_a_node->data + ggml_nbytes(mm_a_node) <= (const char *) add_node->data);
+
+            if (no_alias && ggml_get_op_params_f32(scale_node, 1) == 0.0f &&
+                    ggml_cuda_should_fuse_mul_mat_vec_q(mm_node)) {
+                ggml_cuda_mm_fusion_args_host fusion_data{};
+                fusion_data.lora_b     = lora_b;
+                fusion_data.lora_t     = mm_a_node;
+                fusion_data.lora_scale = ggml_get_op_params_f32(scale_node, 0);
+
+                // t = A @ x folds into the activation-quantize launch when x is a single
+                // contiguous row; otherwise t stays a separate matvec kernel
+                static bool disable_lora_quant_fusion = getenv("GGML_CUDA_DISABLE_LORA_QUANT_FUSION") != nullptr &&
+                    std::atoi(getenv("GGML_CUDA_DISABLE_LORA_QUANT_FUSION"));
+                // Q8_0 A: the fold's post-sync tail beyond the prefetched 1024 elements costs
+                // more than the saved matvec launch when K is large
+                static int64_t lora_q8_max_k = getenv("GGML_CUDA_LORA_FUSION_Q8_MAX_K") ?
+                    atoll(getenv("GGML_CUDA_LORA_FUSION_Q8_MAX_K")) : 4096;
+                const ggml_tensor * x = mm_node->src[1];
+                const bool fold_a = !disable_lora_quant_fusion &&
+                    ggml_is_contiguous(x) && x->ne[1] == 1 && x->ne[2] == 1 && x->ne[3] == 1 &&
+                    mm_a_node->ne[1] == 1 &&
+                    (lora_a->type != GGML_TYPE_Q8_0 || lora_a->ne[0] <= lora_q8_max_k);
+
+                if (fold_a) {
+                    fusion_data.lora_a = lora_a;
+                } else {
+                    ggml_cuda_mul_mat(*cuda_ctx, mm_a_node->src[0], mm_a_node->src[1], mm_a_node);
+                }
+
+                ggml_cuda_mul_mat_vec_q(*cuda_ctx, mm_node->src[0], mm_node->src[1], nullptr, add_node, &fusion_data);
+                return 4;
+            }
+        }
+    }
+
     fused_mul_mat_vec = false;
     fused_node_count  = 0;
 
@@ -3923,8 +4018,10 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 }
             }
 
-            if (should_launch_concurrent_events) {
-                // Restore original node order within each concurrent region to enable fusion within streams
+            if (stream_ctx.concurrent_events.size() > 0) {
+                // Restore original node order within each concurrent region to enable fusion
+                // within streams; do this even when the events are invalid, otherwise the
+                // interleaved order also defeats the single-stream fusions
 
                 std::unordered_map<const ggml_tensor *, int> node_to_idx;
                 node_to_idx.reserve(cgraph->n_nodes);
@@ -3974,7 +4071,8 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                         cgraph->nodes[start_pos + i] = const_cast<ggml_tensor *>(event.original_order[i]);
                     }
                 }
-            } else {
+            }
+            if (!should_launch_concurrent_events) {
