diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index 3bda9abbe..36460a5f1 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -478,6 +478,13 @@ struct node_alloc {
     struct tensor_alloc src[GGML_MAX_SRC];
 };
 
+// a free held back while inside a fork-join concurrency window (GGML_TENSOR_FLAG_BRANCH)
+struct deferred_free {
+    struct ggml_dyn_tallocr * alloc;
+    struct buffer_address addr;
+    size_t size;
+};
+
 struct ggml_gallocr {
     ggml_backend_buffer_type_t * bufts; // [n_buffers]
     struct vbuffer ** buffers; // [n_buffers]
@@ -492,6 +499,12 @@ struct ggml_gallocr {
 
     struct leaf_alloc * leaf_allocs; // [n_leafs]
     int n_leafs;
+
+    // frees held back until the end of the current concurrency window
+    struct deferred_free * deferred_frees;
+    int n_deferred_frees;
+    int deferred_frees_cap;
+    bool defer_frees;
 };
 
 ggml_gallocr_t ggml_gallocr_new_n(ggml_backend_buffer_type_t * bufts, int n_bufs) {
@@ -575,6 +588,7 @@ void ggml_gallocr_free(ggml_gallocr_t galloc) {
     free(galloc->buf_tallocs);
     free(galloc->node_allocs);
     free(galloc->leaf_allocs);
+    free(galloc->deferred_frees);
     free(galloc);
 }
 
@@ -595,6 +609,30 @@ static bool ggml_gallocr_is_allocated(ggml_gallocr_t galloc, struct ggml_tensor
         || ggml_gallocr_is_own(galloc, t); // tensor will be allocated by galloc
 }
 
+// nodes in a fork-join concurrency window run on parallel streams; memory freed inside the
+// window must not be reused before the join, otherwise one branch could overwrite memory
+// another branch still reads (cross-stream WAR hazard)
+static void ggml_gallocr_free_or_defer(ggml_gallocr_t galloc, struct ggml_dyn_tallocr * alloc, struct buffer_address addr, size_t size) {
+    if (!galloc->defer_frees) {
+        ggml_dyn_tallocr_free_bytes(alloc, addr, size);
+        return;
+    }
+    if (galloc->n_deferred_frees == galloc->deferred_frees_cap) {
+        galloc->deferred_frees_cap = galloc->deferred_frees_cap ? 2*galloc->deferred_frees_cap : 16;
+        galloc->deferred_frees = realloc(galloc->deferred_frees, galloc->deferred_frees_cap*sizeof(struct deferred_free));
+        GGML_ASSERT(galloc->deferred_frees != NULL);
+    }
+    galloc->deferred_frees[galloc->n_deferred_frees++] = (struct deferred_free) { alloc, addr, size };
+}
+
+static void ggml_gallocr_flush_deferred_frees(ggml_gallocr_t galloc) {
+    for (int i = 0; i < galloc->n_deferred_frees; i++) {
+        struct deferred_free * df = &galloc->deferred_frees[i];
+        ggml_dyn_tallocr_free_bytes(df->alloc, df->addr, df->size);
+    }
+    galloc->n_deferred_frees = 0;
+}
+
 // free the extra space at the end if the new tensor is smaller
 static void ggml_gallocr_free_extra_space(ggml_gallocr_t galloc, struct ggml_tensor * node, struct ggml_tensor * parent) {
     struct hash_node * hn = ggml_gallocr_hash_get(galloc, node);
@@ -615,7 +653,7 @@ static void ggml_gallocr_free_extra_space(ggml_gallocr_t galloc, struct ggml_ten
         p_addr.offset += node_size;
         size_t extra_size = parent_size - node_size;
         AT_PRINTF("freeing extra %zu bytes from parent %s for %s\n", extra_size, parent->name, node->name);
-        ggml_dyn_tallocr_free_bytes(p_alloc, p_addr, extra_size);
+        ggml_gallocr_free_or_defer(galloc, p_alloc, p_addr, extra_size);
     }
 }
 
@@ -635,6 +673,15 @@ static void ggml_gallocr_allocate_node(ggml_gallocr_t galloc, struct ggml_tensor
                     continue;
                 }
 
+                // inside a concurrency window, do not reuse the buffer of a parent from outside
+                // the window: other branches may still read it on parallel streams
+                if (node->flags & GGML_TENSOR_FLAG_BRANCH) {
+                    if (!(parent->flags & GGML_TENSOR_FLAG_BRANCH) ||
+                        (parent->view_src && !(parent->view_src->flags & GGML_TENSOR_FLAG_BRANCH))) {
+                        continue;
+                    }
+                }
+
                 // if the node's data is external, then we cannot re-use it
                 if (!ggml_gallocr_is_own(galloc, parent)) {
                     AT_PRINTF("not reusing parent %s for %s as %p is external\n", parent->name, node->name, parent->data);
@@ -706,7 +753,7 @@ static void ggml_gallocr_free_node(ggml_gallocr_t galloc, struct ggml_tensor * n
     remove_allocated_tensor(alloc, hn->addr, node);
 #endif
 
-    ggml_dyn_tallocr_free_bytes(alloc, hn->addr, size);
+    ggml_gallocr_free_or_defer(galloc, alloc, hn->addr, size);
     hn->allocated = false;
 }
 
@@ -764,6 +811,12 @@ static void ggml_gallocr_alloc_graph_impl(ggml_gallocr_t galloc, struct ggml_cgr
         struct ggml_tensor * node = graph->nodes[i];
         int buffer_id = get_node_buffer_id(node_buffer_ids, i);
 
+        // hold back frees while inside a fork-join concurrency window, release at the join
+        galloc->defer_frees = (node->flags & GGML_TENSOR_FLAG_BRANCH) != 0;
+        if (!galloc->defer_frees && galloc->n_deferred_frees > 0) {
+            ggml_gallocr_flush_deferred_frees(galloc);
+        }
+
         // allocate parents (only leafs need to be allocated at this point)
         for (int j = 0; j < GGML_MAX_SRC; j++) {
             struct ggml_tensor * parent = node->src[j];
@@ -819,6 +872,9 @@ static void ggml_gallocr_alloc_graph_impl(ggml_gallocr_t galloc, struct ggml_cgr
             AT_PRINTF("\n");
         }
     }
+
+    galloc->defer_frees = false;
+    ggml_gallocr_flush_deferred_frees(galloc);
 }
 
 static bool ggml_gallocr_reserve_n_impl(
