# hydra.toml — beast-hydra routing config (docs/BEAST_HYDRA_PLAN.md §6.2).
#
#   Copy:      cp hydra.toml.example hydra.toml      (hydra.toml is gitignored:
#              it names tailnet hosts)
#   Validate:  scripts/hydra.sh check                 (fails closed: every error listed)
#   Reload:    scripts/hydra.sh reload   (or kill -HUP $(cat .run/hydra.pid))
#              A bad file is refused and the running config is kept.
#   Start:     HYDRA=true in openbeast.conf. With no hydra.toml at all, hydra
#              builds an implicit single-node config that behaves like today:
#              python3 agents/hydra.py --print-default-config > hydra.toml
#
# Vocabulary: a NODE is one engine endpoint. A DEPLOYMENT is one model on one
# node; its id is STRICT (served by that deployment and nothing else — no
# rules, no spill, no failover, 503 when down). A ROUTE is a virtual model id
# with a policy. RULES are deterministic when → then rewrites.
#
# The port and bind are NOT here: HYDRA_PORT in openbeast.conf, and hydra
# always binds 127.0.0.1. Keys live in ~/.config/openbeast/hydra/<node>.key,
# mode 0600 — this example validates only once those files exist.
schema = 1

[hydra]
default_route       = "beast"      # what an unknown/legacy model id resolves to
unknown_model       = "default"    # "default" | "404"
inbound_key_env     = "LLAMA_API_KEY"   # callers must present it; empty env = open (loopback only anyway)
probe_interval_s    = 5            # READY/LOADING probe cadence
probe_down_interval_s = 30         # DOWN/AUTH_FAILED probe cadence
models_interval_s   = 60           # /v1/models re-check (catches a swapped model)
down_after          = 2            # consecutive failed probes → DOWN
up_after            = 2            # consecutive good probes → READY
pre_commit_budget_s = 580          # all attempts before commit; MUST be < gate read timeout (600) and < SDK 600
chars_per_token     = 3.0          # conservative estimate (over-estimates tokens)
ctx_margin          = 0.05
default_max_tokens  = 4096         # assumed completion size when a request has none
list_deployments    = true         # also list strict deployment ids in /v1/models
affinity_ttl_s      = 1800
affinity_max        = 4096
audit               = ".run/hydra-audit.jsonl"
audit_max_mb        = 50
# THE FAMILY POLICY (Max, 2026-09-30: "all of our models are uncensored").
# A hard filter on every non-strict request: first choice, spill, sticky
# affinity, failover, the ctx last resort, and after any rule hop. A route
# target outside it is a config ERROR, so a stock model can never be routed
# to — it can only be reached by naming its strict deployment id (a pin).
# Required once the routes span more than one family: hydra refuses a
# mixed-family config that does not declare which families may answer.
allowed_families    = ["qwen3.8-27b-uncensored", "glm-5.3-flash-uncensored"]

[hydra.breaker]
fail_threshold    = 5
open_s            = 30
success_threshold = 2

# beast-instinct (docs/BEAST_INSTINCT_PLAN.md §5.11, instinct-route/1). Only
# consulted when a rule below uses `when.task_class`, only when >= 2 eligible
# deployments remain after hydra's own hard filters, and its answer is APPLIED
# only when instinct says action = "act" AND enforce = true (enforcement comes
# from instinct's eval-gate record, never from a toggle here). Otherwise it is
# logged as shadow and the static policy decides. Instinct absent = static policy.
[hydra.instinct]
enabled        = true
url            = "http://127.0.0.1:8094"   # loopback only
key_file       = ".run/instinct.key"
deadline_ms    = 800                        # sized for a FULL 27B scorer (Max: routing decisions go to
                                            # a 27B — Open-Jev local, the rig 27B by logprobs meanwhile).
                                            # Brief estimate 0.2-0.6 s prefill on the 5090 — VERIFY on
                                            # hardware. The consult is awaited before the first byte;
                                            # a miss falls back to the static policy for that request.
contract_ttl_s = 60
feedback       = true                       # POST /v1/instinct/feedback per request (trace_id)
# instinct's engines, when one is ALSO a node here. The instinct SERVICE url
# above is never a node (that would loop through hydra); an engine instinct
# calls directly is no loop. Max's direction: instinct decides on a full
# 27B — the rig's own 27B by logprob scoring until Open-Jev-27B has a GPU of
# its own. Listing it here makes `check` warn that hydra cannot count
# instinct's direct calls: on the 1-slot rig they queue with routed turns.
# engine_urls  = ["http://127.0.0.1:8080"]

# ─────────────────────────── nodes ───────────────────────────
[nodes.rig]                                   # the 5090, launched + supervised by start.sh
url         = "http://127.0.0.1:8080"
engine      = "llama"                         # llama | vllm | tensorfold | openai
key_env     = "LLAMA_API_KEY"
slots       = 1                               # MTP forces -np 1
gpu_lease   = true                            # drain while an eval campaign holds scripts/gpu-lease.sh
ttft_timeout_s = 120
labels      = ["local", "5090", "mtp"]

[nodes.sparks]                                # both Sparks, TensorFold TP=2 = ONE node (rank 0 serves HTTP)
url         = "http://100.101.102.103:8000"   # tensorfold/spark-node.sh rank 0 (tailnet IP)
engine      = "tensorfold"                    # never gets a key; MUST be firewalled to the rig (DGX §7)
slots       = 1                               # TENSORFOLD_PARALLEL=auto = one request at a time on CUDA (VERIFY)
members     = ["spark-a", "spark-b"]
exclusive_group = "spark-pair"                # any other engine on these boxes joins this group, disabled
connect_timeout_s = 5
ttft_timeout_s    = 120                       # VERIFY: 320B/18B-active prefill on GB10 is unmeasured
prefill_tps_floor = 500                       # VERIFY: ttft deadline += est_prompt_tokens / floor
idle_timeout_s    = 180
labels      = ["remote", "gb10", "tp2"]

[nodes.ti]                                    # 2× RTX 3090 Ti, llama.cpp --tensor-split
url         = "http://100.64.10.20:8080"
engine      = "llama"
key_file    = "~/.config/openbeast/hydra/ti.key"
slots       = 4                               # VERIFY: the -np the Ti's serve script really runs
connect_timeout_s = 5
labels      = ["remote", "ampere"]

# role = "instinct-engine" is REFUSED: a dedicated instinct scorer is never a hydra pool.

# ─────────────────────── deployments (strict ids) ───────────────────────
# EVERY deployment is uncensored (hydra.allowed_families). A stock model has
# no place in a route; list one here only to pin it by id, and `check` warns.
[deployments."qwen38-unc-q5@rig"]
node     = "rig"
upstream = "Qwen3.8 27B Uncensored MTP Q5"   # llama-server lists its -a ALIAS as the id — this is
                                              # serve-qwen38-27b-uncensored-mtp-q5.sh's -a, not the slug
ctx      = 262144                             # the full -c: --kv-unified, never divide by slots
family   = "qwen3.8-27b-uncensored"
caps     = ["tools", "json_schema", "grammar", "reasoning_budget", "vision", "id_slot"]
# upstream must be listed by the node's /v1/models, or the deployment is
# MISMATCH (a relaunched node serving other weights is never routed to).
# For llama.cpp that id is the serve script's `-a "..."`; read it off the
# node:  curl -s -H "Authorization: Bearer $KEY" <url>/v1/models
# (`scripts/hydra.sh add-node` prints it). verify_upstream = false turns the
# check off — only while the served id is unknown.

[deployments."qwen38-unc-q5@ti"]
node     = "ti"
upstream = "Qwen3.8 27B Uncensored Q5"        # the -a of serve-qwen38-27b-uncensored-q5.sh: the SAME
                                              # GGUF as the rig's, without MTP, so it can run -np > 1
ctx      = 262144                             # VERIFY on 48 GB (the rig measured 26.2 GB at 6 slots)
family   = "qwen3.8-27b-uncensored"           # same weights as the rig = same family
caps     = ["tools", "json_schema", "grammar", "reasoning_budget", "id_slot"]

[deployments."glm53-flash-unc@sparks"]
# GLM-5.3-Flash Uncensored (320B total / 18B active), EXL3 TR3 4bpw — the
# only EXL3 TensorFold's glm5_next reader accepts (4-bit, mcg codebook,
# routed experts only): neko-legends/GLM-5.3-Flash-Uncensored-EXL3 (gated;
# built from orcarouter's FP8). Profile: glm53-flash-unc-exl3-tensorfold.
# Once that profile is in scripts/backends/models/, replace upstream + ctx
# with   profile = "glm53-flash-unc-exl3-tensorfold"   (they must match its
# SERVED_MODEL_NAME / MAX_MODEL_LEN, or `check` refuses the file).
node     = "sparks"
upstream = "glm-5.3-flash-uncensored"         # VERIFY: the profile's SERVED_MODEL_NAME
ctx      = 262144                             # VERIFY: TensorFold's EXL3 long context is "TBD" upstream
family   = "glm-5.3-flash-uncensored"
caps     = ["tools"]                          # TensorFold: no json_schema / grammar / reasoning_budget
conformance = "required"                      # default for non-loopback nodes anyway:
                                              # scripts/hydra.sh conformance glm53-flash-unc@sparks

# ────────────────────────── routes (virtual ids) ──────────────────────────
# Lower priority = tried first. Inside a group: affinity, then least (inflight+1)/slots/weight.
# `family = "..."` makes a route same_family, anchored on that family: it
# never answers from another one, not even after a rule sends it elsewhere.
[routes.beast]
description = "Daily driver: the uncensored 27B on the 5090, spill to the same weights on the Ti"
targets = [
  { d = "qwen38-unc-q5@rig", priority = 0 },
  { d = "qwen38-unc-q5@ti",  priority = 1 },
]
spill        = true
family       = "qwen3.8-27b-uncensored"   # Max 2026-09-30: `beast` is one model, whichever box answers
affinity     = "sticky"       # a conversation that spilled stays where its cache is while healthy
aliases      = ["qwen-27b-q5", "qwen38-27b-uncensored-mtp-q5", "default", "local"]

[routes."beast:max"]
description = "Quality-first: wait for the best model rather than spill down"
targets = [ { d = "qwen38-unc-q5@rig", priority = 0 } ]   # a Sparks flagship joins ONLY after a paired eval win
spill   = false

[routes."beast:fast"]
description = "Throughput: the multi-slot uncensored 27B on the Ti, then the rig"
targets = [
  { d = "qwen38-unc-q5@ti",  priority = 0 },
  { d = "qwen38-unc-q5@rig", priority = 1 },
]

[routes."beast:glm"]
description = "The Sparks flagship, by name only: GLM-5.3-Flash Uncensored or nothing"
targets = [ { d = "glm53-flash-unc@sparks", priority = 0 } ]
spill   = false

[routes."beast:long"]
description = "Long context: the Sparks first, then the 27Bs"
targets = [
  { d = "glm53-flash-unc@sparks", priority = 0 },
  { d = "qwen38-unc-q5@rig",      priority = 1 },
  { d = "qwen38-unc-q5@ti",       priority = 1 },
]
min_ctx = 200000

[routes."beast:vision"]
targets = [ { d = "qwen38-unc-q5@rig", priority = 0 } ]
require = ["vision"]

[routes.classify]                             # agents/router.py sends model:"classify" (ROUTER_CLASSIFY_MODEL)
description = "Grammar-constrained spawn classifier — a full 27B, kept off the 1-slot 5090"
# Decisions go to a full model, never a small or 3B-active one (the 35B-A3B
# MoE here is ~3B active; the MoE lesson: judge by active compute), and never
# to a stock one. Add another deployment only if it is an uncensored dense
# 27B-class model (tests/test_hydra_core.py pins this).
targets = [
  { d = "qwen38-unc-q5@ti",  priority = 0 },
  { d = "qwen38-unc-q5@rig", priority = 1 },
]
require      = ["json_schema"]
affinity     = "none"
max_attempts = 2
listed       = false

# ─────────────────────────────── rules ───────────────────────────────
# Rules are ROUTING POLICY, not access control: they only see non-strict
# requests, so any caller holding the inference key can name a deployment id
# (model = "qwen38-unc-q5@rig", /pin/<d>/…, X-Hydra-Pin) and skip every rule —
# and list_deployments = true shows those ids in the WebUI picker. A rule like
# "guests-off-the-5090" steers well-behaved traffic; it does not keep anyone
# off the 5090. Per-device ACLs are future work (plan X13); until then keep
# enforcement at the gate (per-device keys, scripts/clients.sh revoke).
# Evaluated top to bottom for NON-strict requests. For each `then` key the FIRST rule that sets it wins.
# when: model, device, role, has_images, has_tools, needs_json_schema,
#       min_prompt_tokens, hours ("HH:MM-HH:MM", may wrap midnight), task_class
# then: route (one hop, never chained), only_nodes, ignore_nodes, require, prefer
# Scope every `then.route` with `when.model`: without it the rule rewrites
# EVERY route, beast:max included (`check` warns).
[[rules]]
name = "images-need-vision"
when = { has_images = true, model = ["beast", "beast:fast"] }
then = { route = "beast:vision" }

[[rules]]
name = "huge-prompts-go-long"
when = { min_prompt_tokens = 120000, model = ["beast", "beast:fast"] }
then = { route = "beast:long" }               # `beast` keeps its family through the hop: rig/Ti, never GLM

[[rules]]
name = "guests-off-the-5090"
when = { role = "user" }                      # trusted only with X-Hydra-Caller (router); policy, not ACL
then = { ignore_nodes = ["rig"] }

[[rules]]
name = "phone-stays-on-fast"
when = { device = "max-phone", model = ["beast"] }   # trusted only with X-Hydra-Caller (gate)
then = { route = "beast:fast" }

# A judgement rule fed by beast-instinct. Shadow-only until instinct's eval
# gate promotes `task_class` to enforce: until then it never fires, and the
# audit records what it WOULD have done (instinct.shadow_deployment). Both
# sides are the same full uncensored 27B — instinct picks the box, never a
# smaller model.
# [[rules]]
# name = "bulk-to-fast"
# when = { task_class = "bulk", model = ["beast"] }
# then = { route = "beast:fast" }
