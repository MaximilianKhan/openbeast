# beast-recipe minimax-m31-flash-exl3-3.06-tp2: MiniMax-M3.1-Flash EXL3 3.06 bpw (Mia EAQ v1) on native
# TensorFold 1.2.10, TP2 (exactly 2 ranks), through D2. Candidate 3 of the investigation: the first new
# architecture on the pair built entirely by OpenBeast, on an engine family that already exists.
# Never run here; ~171 GB to download to both Sparks.
# Made by `beast-recipe init Mia-AiLab/MiniMax-M3.1-Flash-EXL3-EAQ-v1-3.06-bpw@c33e7a66 --engine tf-native-1.2.10`.
#
# Parsed, never sourced (scripts/backends/pylib/recipe.py). Provenance after each value: READ = the
# files of the checkpoint (beast-recipe init), HUB = the Hub API, DATA = data/recipe-engines.json,
# MEASURED / VERIFIED / CLAIMED / ESTIMATED as in the investigation, VERIFY = check on hardware.
# docs/BEAST_RECIPE.md

# identity
TITLE='MiniMax-M3.1-Flash EXL3 3.06 bpw on native TensorFold 1.2.10, TP2'  # USER
SOURCE=Mia-AiLab/MiniMax-M3.1-Flash-EXL3-EAQ-v1-3.06-bpw  # HUB: the model given to init
REVISION=c33e7a6619f0f12ac99098e07ec5e56acb7eeda9  # HUB: pinned
WEIGHTS_STATUS=published  # DEFAULT
LICENCES='weights=other (minimax-community, via base MiniMaxAI/MiniMax-M3.1-Flash)'  # HUB: the base card cardData.license_name, 2026-11-22; commercial use needs "Built with MiniMax M3.1-Flash" + a notice to MiniMax, written authorization above US$20M yearly revenue; read the prohibited-use appendix
# what the checkpoint is (read by model_inspect.py)
ARCHITECTURE=MiniMaxM3SparseForConditionalGeneration  # READ: config.json architectures
MODEL_TYPE=minimax_m3_vl  # READ: config.json model_type
FORMAT=exl3  # READ: EXL3 ? bpw, mul1 codebook
BPW=3.06  # READ: quantization_config.bits
EXL3_CODEBOOK=mul1  # READ: quantization_config.codebook
WEIGHT_BYTES=170977037593  # READ: 22 safetensors files
LAYERS=60  # READ: config.json
ATTENTION_HEADS=64  # READ: config.json
KV_HEADS=4  # READ: config.json
KV_BYTES_PER_TOKEN=122880  # ESTIMATED: 2 (K,V) x 60 layers x 4 kv-heads x 128 dim x 2 B (bf16 KV; fp8 KV halves it)
NATIVE_CONTEXT=1048576  # READ: config.json max_position_embeddings
EXPERTS=128  # READ: config.json
EXPERTS_ACTIVE=4  # READ: config.json
# serving choices
SPARKS=2  # USER: the pair (the family runs at exactly 2)
ENGINE=tf-native-1.2.10  # USER: installed; minimax_m3_vl EXL3 at TP2 (capabilities --json)
LAUNCHER=d2-tensorfold  # DATA
PROFILE=recipe-minimax-m31-flash-exl3-3.06-tp2  # USER: rendered by beast-recipe up --write-profile
SERVED_NAME=minimax-m3.1-flash-exl3  # DEFAULT
PORT=8000  # DEFAULT
CONTEXT=131072  # VERIFY: the start line says what it admits
PARALLEL=4  # DEFAULT
KV_DTYPE=fp8  # ESTIMATED
KV_POOL_GIB=8  # ESTIMATED: 80 GiB of weights a rank leaves ~16 GiB above the reserve and the OS
MEMORY_RESERVE_GIB=9.5  # ESTIMATED: GLM 1104 value
DRAFTER=none  # USER: the pack ships an in-checkpoint DSpark draft (dspark/, 5 layers, block 7; README: acceptance NOT TESTED; DATA): serve plain first, then A/B it
TOOL_PARSER=minimax_m2  # VERIFY: model_inspect suggested hermes from the template; MiniMax's own format is <minimax:tool_call>
REASONING_PARSER=minimax_m3  # ESTIMATED: model_inspect
