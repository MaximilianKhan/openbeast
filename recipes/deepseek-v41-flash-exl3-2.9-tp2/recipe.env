# beast-recipe deepseek-v41-flash-exl3-2.9-tp2: DeepSeek-V4.1-Flash (Mia EXL3 EAQ, 2.9 bpw) on the pair:
# what serves by default today, through Mia's recipe (the dsv41 Zig fork image, unit
# deepseek-v41-inference, beast-spark ds). Recorded so beast-recipe plans it like every other model:
# the engine is Mia's fork, so up / adopt hand over to beast-spark ds. The served pack is the local
# -v2 folder (EAQ v1.1); the Hub repo below is the v1 pack with the same tensor index.
# Made by `beast-recipe init Mia-AiLab/DeepSeek-V4.1-Flash-1017-EXL3-EAQ-v1-2.9-bpw@45ee5d0f --engine tf-fork-dsv41`.
#
# Parsed, never sourced (scripts/backends/pylib/recipe.py). Provenance after each value: READ = the
# files of the checkpoint (beast-recipe init), HUB = the Hub API, DATA = data/recipe-engines.json,
# MEASURED / VERIFIED / CLAIMED / ESTIMATED as in the investigation, VERIFY = check on hardware.
# docs/BEAST_RECIPE.md

# identity
TITLE='DeepSeek-V4.1-Flash EXL3 2.9 bpw (Mia EAQ) on the dsv41 fork, TP2 (the default model)'  # USER
SOURCE=Mia-AiLab/DeepSeek-V4.1-Flash-1017-EXL3-EAQ-v1-2.9-bpw  # HUB: the model given to init
REVISION=45ee5d0fd106c94a3d77f721e09cbb2f50e5a16b  # HUB: pinned
WEIGHTS_STATUS=local  # VERIFIED: the -v2 pack on both Sparks (spark-families.json known_packs)
WEIGHTS_DIR=~/Documents/Mia-AiLab-DeepSeek-V4.1-Flash-1017-EXL3-EAQ-v1-2.9-bpw-v2  # VERIFIED: beast-spark V2_PACK
LICENCES='weights=mit; engine=apache-2.0 (fork, patches, kernel kit)'  # VERIFIED: investigation section 6
# what the checkpoint is (read by model_inspect.py)
ARCHITECTURE=DeepseekV41ForCausalLM  # READ: config.json architectures
MODEL_TYPE=deepseek_v41  # READ: config.json model_type
FORMAT=exl3  # READ: EXL3 ? bpw, mul1 codebook
BPW=2.9  # READ: quantization_config.bits
EXL3_CODEBOOK=mul1  # READ: quantization_config.codebook
WEIGHT_BYTES=210601036966  # READ: 39 safetensors files
LAYERS=40  # READ: config.json
ATTENTION_HEADS=64  # READ: config.json
KV_HEADS=1  # READ: config.json (empty: MLA latents)
KV_BYTES_PER_TOKEN=81920  # ESTIMATED: 2 (K,V) x 40 layers x 1 kv-heads x 512 dim x 2 B (bf16 KV; fp8 KV halves it)
NATIVE_CONTEXT=1048576  # READ: config.json max_position_embeddings
EXPERTS=384  # READ: config.json
EXPERTS_ACTIVE=6  # READ: config.json
# serving choices
SPARKS=2  # VERIFIED: serving on the pair since 2026-11-17
ENGINE=tf-fork-dsv41  # VERIFIED: the only engine that serves deepseek_v41 on a GB10 today
LAUNCHER=mia-unit:deepseek-v41-inference  # VERIFIED: beast-spark ds
SERVED_NAME=DeepSeek-V4.1-Flash-1017  # VERIFIED: beast-spark DS_SERVED
PORT=8000  # VERIFIED
CONTEXT=524288  # VERIFIED: the recipe config.sh CONTEXT
PARALLEL=4  # VERIFIED: PARALLEL=4
KV_DTYPE=fp4-compressed  # VERIFIED: compressed FP4 latents
KV_POOL_GIB=1.8  # VERIFIED: ~1.8 GiB at the full window
MEMORY_RESERVE_GIB=12.2  # VERIFIED: TENSORFOLD_MEMORY_RESERVE_GIB, do not lower
MIN_AVAIL_GIB=112  # VERIFIED: the recipe MIN_AVAIL_GIB
DRAFTER=in-checkpoint:dspark  # READ: config.json dspark_* keys (layers 37-39, 4-bit)
REASONING_PARSER=deepseek_v4  # ESTIMATED: model_inspect; the fork has its own DSML parser patches
AUX='Engram tables: deepseek-ai/DeepSeek-V4.1-Flash-1017@1bae0e10 shards 47 and 48 (203 GB) on every Spark local disk'  # VERIFIED: spark-families.json
RANK_INPUTS='tf-dsv41-rank-cache MODEL DIR R 2 (rank files ~106 GB each, no GPU), the Engram token map, the kit RoPE tables'  # VERIFIED: the DeepSeek recipe
