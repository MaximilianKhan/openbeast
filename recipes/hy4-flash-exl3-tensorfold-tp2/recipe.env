# beast-recipe hy4-flash-exl3-tensorfold-tp2: Hy4-flash EXL3 4bpw (LibertAIDAI) on native TensorFold, TP2.
# A PLAN, not a serve: Max wants a TensorFold recipe for Hy4-flash to see whether it beats vLLM
# (hy4-flash-nvfp4-vllm-tp2: 31.4 tok/s at 1 stream, 77.8 aggregate at 4). Upstream 1.3.2 (#4003) loads
# this pack on ONE GB10 (85.38 GiB) with the opt-in CUDA slab mode; 1.3.3 (#4259, lands #4004) adds a greedy
# generator, tf-hy4-cuda-generate, built from source (the release archives ship only tensorfold-native).
# Serving it at TP2 needs a two-Spark hy_v4_flash family (TensorFold#3797 / #3801, upstream, in slices).
# Pinned to 1.3.3: the 1.3.4 release (2026-11-22) adds no Hy4/hy_v4 server path, so the plan is the same.
# `beast-recipe plan` lists the work.
# The pack is on both Sparks at ~/Documents/LibertAIDAI-Hy4-flash-EXL3-4bpw and is KEPT (Max,
# 2026-11-19): beast-recipe reads it, never writes, moves or deletes it.
# Made by `beast-recipe init LibertAIDAI/Hy4-flash-EXL3-4bpw@811866b0 --engine tf-native-1.3.4` (2026-11-22);
# re-pinned to tf-native-1.3.3 the same day (v1.3.4 had no release yet; it adds no Hy4 path).
#
# Parsed, never sourced (scripts/backends/pylib/recipe.py). Provenance after each value: READ = the
# files of the checkpoint (beast-recipe init), HUB = the Hub API, DATA = data/recipe-engines.json,
# MEASURED / VERIFIED / CLAIMED / ESTIMATED as in the investigation, VERIFY = check on hardware.
# docs/BEAST_RECIPE.md

# identity
TITLE='Hy4-flash EXL3 4bpw on native TensorFold, TP2 (plan: beat vLLM)'  # USER
SOURCE=LibertAIDAI/Hy4-flash-EXL3-4bpw  # HUB: the model given to init
REVISION=811866b0e16d6ad55cdc82f73bfd521675b77030  # HUB: pinned
WEIGHTS_STATUS=local  # VERIFIED: on both Sparks (ls ~/Documents on spark-1, 2026-11-22; 218,069,370,574 B in 28 shards)
WEIGHTS_DIR=/home/max/Documents/LibertAIDAI-Hy4-flash-EXL3-4bpw  # VERIFIED: the kept pack (read only)
LICENCES='weights=other (tencent-hy-license)'  # READ: README.md front matter
RESIDENT_BYTES=91676149841  # CLAIMED: TensorFold 1.3.2 CHANGELOG (#4003, with the opt-in CUDA slab mode), 85.38 GiB loaded on one GB10; ~118 GiB of Engram streams from disk
# what the checkpoint is (read by model_inspect.py)
ARCHITECTURE=HYV4FlashForCausalLM  # READ: config.json architectures
MODEL_TYPE=hy_v4_flash  # READ: config.json model_type
FORMAT=exl3  # READ: EXL3 4 bpw, mul1 codebook, scope hy4flash-routed-k4
BPW=4  # READ: quantization_config.bits
EXL3_CODEBOOK=mul1  # READ: quantization_config.codebook
EXL3_SCOPE=hy4flash-routed-k4  # READ: quantization_config.scope
WEIGHT_BYTES=218069370574  # READ: 28 safetensors files
LAYERS=42  # READ: config.json
ATTENTION_HEADS=32  # READ: config.json
KV_BYTES_PER_TOKEN=34560  # ESTIMATED: MLA latent 576 x 30 layers x 2 B
NATIVE_CONTEXT=1048576  # READ: config.json max_position_embeddings
EXPERTS=512  # READ: config.json
EXPERTS_ACTIVE=16  # READ: config.json
# serving choices
SPARKS=2  # USER: the pair
ENGINE=tf-native-1.3.3  # USER: the hy_v4_flash generator source is in it (1.3.3, #4259); 1.3.4 adds no Hy4 path
SERVED_NAME=Hy4-flash-EXL3-4bpw  # DEFAULT
PORT=8000  # DEFAULT
CONTEXT=262144  # USER: the same window as the vLLM baseline
PARALLEL=4  # USER: the same streams as the vLLM baseline
KV_DTYPE=bf16  # ESTIMATED: MLA latents are small (34,560 B a token at bf16)
KV_POOL_GIB=6  # ESTIMATED: the vLLM baseline's 6 GiB; VERIFY on the first start line
MEMORY_RESERVE_GIB=9.5  # ESTIMATED: GLM 1104's native value before 2026-11-11 (6.5 since); VERIFY
DRAFTER=in-checkpoint:dfly  # READ: config.json dfly_* keys (the TensorFold family must implement DFly drafting)
REASONING_PARSER=hy_v4  # VERIFY: the name vLLM uses; TensorFold needs its own
TOOL_PARSER=hy_v4  # VERIFY: the name vLLM uses; TensorFold needs its own
AUX='Engram tables (~118 GiB) inside the pack, streamed from each Spark local NVMe, never over NFS'  # CLAIMED
BASELINE_FROM=hy4-flash-nvfp4-vllm-tp2  # USER
BASELINE_TOKS_1=31.4  # MEASURED: docs/SPARK_HYDRA.md (through the gate, 512-token code prompts, thinking high, temp 0, DFly 5)
BASELINE_TOKS_4=77.8  # MEASURED: docs/SPARK_HYDRA.md, aggregate of 4 streams
