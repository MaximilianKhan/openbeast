# beast-recipe hy4-flash-nvfp4-vllm-tp2: Hy4-flash NVFP4 on vLLM, TP2 + expert parallel over the pair.
# THE SERVED CONFIG, as data: scripts/backends/hy4-vllm/config.sh + start.sh are what runs it (launcher
# hy4-vllm), and tests/test_beast_recipe.py checks that the vLLM flags rendered from this file equal
# hy4_serve_args exactly. Made by `beast-recipe init https://huggingface.co/atakans/Hy4-flash-NVFP4/tree/30f201ac
# --engine vllm-hy4` (2026-11-22, the Hub), then the serving section copied from config.sh by hand.
#
# Parsed, never sourced (scripts/backends/pylib/recipe.py). Provenance after each value: READ = the
# files of the checkpoint (beast-recipe init), HUB = the Hub API, DATA = data/recipe-engines.json,
# MEASURED / VERIFIED / CLAIMED / ESTIMATED as in the investigation, VERIFY = check on hardware.
# docs/BEAST_RECIPE.md

# identity
TITLE='Hy4-flash NVFP4 on vLLM, TP2 + expert parallel (the served config)'  # USER
SOURCE=atakans/Hy4-flash-NVFP4  # HUB: the model given to init
REVISION=30f201acf0b4f9ba178817bcbc04ccfa3ec473f9  # HUB: pinned
WEIGHTS_STATUS=local  # VERIFIED: staged and verified on both Sparks (.hy4-verified), 2026-11-21
WEIGHTS_DIR=~/Documents/atakans-Hy4-flash-NVFP4  # VERIFIED: HY4_MODEL_DIR in hy4-vllm/config.sh
LICENCES='weights=other (tencent-hy-license)'  # READ: README.md front matter
# what the checkpoint is (read by model_inspect.py)
ARCHITECTURE=HYV4FlashForConditionalGeneration  # READ: config.json architectures
MODEL_TYPE=hy_v4_flash  # READ: config.json model_type
FORMAT=modelopt-nvfp4  # READ: ModelOpt NVFP4
BPW=4.5  # ESTIMATED: NVFP4 = 4 bits + an FP8 scale per 16 values
WEIGHT_BYTES=164654390950  # READ: 14 safetensors files
LAYERS=42  # READ: config.json
ATTENTION_HEADS=32  # READ: config.json
KV_BYTES_PER_TOKEN=34560  # ESTIMATED: MLA latent 576 x 30 layers x 2 B
NATIVE_CONTEXT=1048576  # READ: config.json max_position_embeddings
EXPERTS=512  # READ: config.json
EXPERTS_ACTIVE=16  # READ: config.json
# serving choices
SPARKS=2  # VERIFIED: hy4-vllm/config.sh (TP2 over spark-1 + spark-2)
ENGINE=vllm-hy4  # USER: the only engine that serves hy_v4_flash NVFP4 here
LAUNCHER=hy4-vllm  # VERIFIED: scripts/backends/hy4-vllm (unit hy4-vllm-inference; beast-spark hy4)
SERVED_NAME=Hy4-flash-NVFP4  # VERIFIED: HY4_SERVED
PORT=8000  # VERIFIED: HY4_PORT
IMAGE=openbeast/hy4-vllm:e764efa-b486c74ef8b6  # VERIFIED: HY4_IMAGE (docker image ls on spark-1, 6477587cdc52)
BASE_IMAGE=vllm/vllm-openai@sha256:5e2c1badbca60595d6591c60feb4b8547f59da96e7a91710d40239250e721aba  # VERIFIED: HY4_BASE_IMAGE
CONTEXT=262144  # MEASURED: the start line, max_model_len 262144 (journal 2026-11-21)
PARALLEL=4  # MEASURED: max_num_seqs 4
DTYPE=bfloat16  # VERIFIED: hy4_serve_args
EXPERT_PARALLEL=true  # VERIFIED: without it each Spark holds every expert and the model does not fit
MAX_NUM_SEQS=4  # VERIFIED: HY4_MAX_NUM_SEQS (= the campaign arm's --jobs 4 --slots 4)
MAX_BATCHED_TOKENS=8192  # VERIFIED: HY4_MAX_BATCHED
KV_CACHE_BYTES=6G  # VERIFIED: HY4_KV_BYTES (578k tokens of KV, CLAIMED)
KV_DTYPE=auto  # VERIFIED: no --kv-cache-dtype flag
GPU_MEM_UTIL=0.85  # VERIFIED: HY4_GMU
MEMORY_RESERVE_GIB=5  # ESTIMATED: activations, graphs, the sampler
MIN_AVAIL_GIB=106  # VERIFIED: HY4_MIN_AVAIL_GIB auto = ceil(0.85 x 121.7) + 2
DRAFTER=in-checkpoint:dfly  # READ: config.json dfly_* keys
SPEC_CONFIG='{"method":"dfly","num_speculative_tokens":5}'  # VERIFIED: HY4_SPEC (17-38 tok/s against ~15 plain, CLAIMED)
MM_LIMIT='{"image":1,"video":0}'  # VERIFIED: HY4_MM_LIMIT
REASONING_PARSER=hy_v4  # VERIFIED: hy4_serve_args; conformance PASS 2026-11-22
TOOL_PARSER=hy_v4  # VERIFIED: hy4_serve_args; conformance PASS 2026-11-22
AUTO_TOOL_CHOICE=true  # VERIFIED: --enable-auto-tool-choice
AUX='Engram tables (64B parameters, FP8) are inside the checkpoint'  # CLAIMED: the model card
