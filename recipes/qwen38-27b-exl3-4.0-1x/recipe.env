# beast-recipe qwen38-27b-exl3-4.0-1x: Qwen3.8-27B EXL3 4.0 bpw (turboderp, branch SCP_4.00bpw) on ONE
# Spark, native TensorFold 1.3.4 (candidate 2 of the investigation: TP1, a model new to the Sparks, an
# own drafter choice). Max chose 1.3.4 (2026-11-22); it was pinned to 1.3.3 while 1.3.4 had no release,
# and re-pinned to 1.3.4 once v1.3.4 was published (2026-11-22 20:53Z). Neither is needed for this pack:
# it is mul1 (1.2.10 reads it; the mcg admission is 1.3.3's) and it drafts with DFlash2, not MTP (1.3.4's
# dense MTP for Qwen3.5 targets, #3582, plus a Qwen DFlash2 absorb-batch opt-in, CLAIMED +1-2% at 4
# streams, are the reasons for 1.3.4). The plan shows the installed 1.2.10 is SERVABLE-NOW at TP1.
# On the pair, ONE Spark means the pair's model is down (or a third Spark).
# Made by `beast-recipe init https://huggingface.co/turboderp/Qwen3.8-27B-exl3/tree/387b8445 --sparks 1
# --engine tf-native-1.3.4` (2026-11-22); pinned to tf-native-1.3.3 until the 1.3.4 release, then back.
#
# Parsed, never sourced (scripts/backends/pylib/recipe.py). Provenance after each value: READ = the
# files of the checkpoint (beast-recipe init), HUB = the Hub API, DATA = data/recipe-engines.json,
# MEASURED / VERIFIED / CLAIMED / ESTIMATED as in the investigation, VERIFY = check on hardware.
# docs/BEAST_RECIPE.md

# identity
TITLE='Qwen3.8-27B EXL3 4.0 bpw on ONE Spark, native TensorFold 1.3.3'  # USER
SOURCE=turboderp/Qwen3.8-27B-exl3  # HUB: the model given to init
REVISION=387b844556856493893ed14f72bca8b2aee5b8b4  # HUB: branch SCP_4.00bpw (not 4.00bpw = 113cf7ab, not SC_4.00bpw_H5 = 4acd9ad5; main = 3f8a2d64 holds metadata only). VERIFY: this EXL3 variant (bits 4.0, head 5, mtp 4, vision 6, mul1) has never run on native TensorFold; upstream supported-models.md lists the 27B only as MLX 4-bit, and the qwen3_5 exl3 admission comes from capabilities --json alone
WEIGHTS_STATUS=published  # DEFAULT
LICENCES=weights=apache-2.0  # READ: README.md front matter
# what the checkpoint is (read by model_inspect.py)
ARCHITECTURE=Qwen3_5ForConditionalGeneration  # READ: config.json architectures
MODEL_TYPE=qwen3_5  # READ: config.json model_type
FORMAT=exl3  # READ: EXL3 4.0 bpw, mul1 codebook
BPW=4  # READ: quantization_config.bits
EXL3_CODEBOOK=mul1  # READ: quantization_config.codebook
WEIGHT_BYTES=16354404956  # READ: 3 safetensors files
LAYERS=64  # READ: config.json
ATTENTION_HEADS=24  # READ: config.json
KV_HEADS=4  # READ: config.json
KV_BYTES_PER_TOKEN=65536  # ESTIMATED: 2 (K,V) x 16 layers x 4 kv-heads x 256 dim x 2 B (bf16 KV; fp8 KV halves it)
NATIVE_CONTEXT=262144  # READ: config.json max_position_embeddings
# serving choices
SPARKS=1  # USER: one Spark
ENGINE=tf-native-1.3.4  # USER: Max chose 1.3.4 (2026-11-22), the latest published release
LAUNCHER=d2-tensorfold  # DATA
PROFILE=recipe-qwen38-27b-exl3-4.0-1x  # USER: rendered by beast-recipe up --write-profile
SERVED_NAME=qwen3.8-27b-exl3  # DEFAULT
PORT=8000  # DEFAULT
CONTEXT=262144  # VERIFY: the start line says what it admits
PARALLEL=4  # DEFAULT
KV_DTYPE=bf16  # ESTIMATED
KV_POOL_GIB=16  # ESTIMATED: 15 GiB of weights leaves room for a large pool
MEMORY_RESERVE_GIB=6.5  # ESTIMATED
DRAFTER=z-lab/Qwen3.8-27B-DFlash2@50307d4c4cde6860d4eee73e2547cd786fe8e8a4  # VERIFIED: Hub API cardData.license apache-2.0, 2026-11-22
TOOL_PARSER=qwen3_xml  # ESTIMATED: model_inspect from the template; conformance decides
REASONING_PARSER=qwen3  # ESTIMATED: model_inspect; conformance decides
