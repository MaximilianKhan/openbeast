# beast-recipe deepseek-v41-flash-exl3-4.0: DeepSeek-V4.1-Flash at 4.0 bpw EXL3, planned for the pair.
# The answer this recipe exists to give: NEEDS-MORE-HARDWARE, 4 Sparks. At 4.0 bpw the checkpoint is
# ~267 GiB (14 + 63.3 x 4, the sizing rule from Mia's measured 2.9 pack): 135 GiB a rank at TP2 does
# not fit, and the only DeepSeek engine (the dsv41 Zig fork) takes WORLD 1, 2 or 4 (upstream plans 3 ranks
# as 24/24/16 heads, but no engine serves 3 ranks yet: TensorFold #2270; at ~90.5 GiB a rank, TP3 would
# fit once it does), so the next size is 4: ~68 GiB a rank. No 4.0 pack exists either: it has to be
# quantized (exllamav3 convert.py, the layout the fork reads: mul1, out_scales=always, the reference
# tensor index). Hand-written on 2026-11-22 from deepseek-v41-flash-exl3-2.9-tp2 (whose values init read).
# Parsed, never sourced (scripts/backends/pylib/recipe.py). Provenance after each value: READ = the
# files of the checkpoint (beast-recipe init), HUB = the Hub API, DATA = data/recipe-engines.json,
# MEASURED / VERIFIED / CLAIMED / ESTIMATED as in the investigation, VERIFY = check on hardware.
# docs/BEAST_RECIPE.md

# identity
TITLE='DeepSeek-V4.1-Flash EXL3 4.0 bpw (to quantize) on the dsv41 fork'  # USER
WEIGHTS_STATUS=to-quantize  # ESTIMATED: no 4.0 bpw pack is published (the LibertAI 3.5 pack is the nearest)
QUANTIZE_FROM='deepseek-ai/DeepSeek-V4.1-Flash-1017@1bae0e10 (FP8 + MXFP4, ~510 GB = 475 GiB)'  # VERIFIED: the Engram tables come from the same revision
WEIGHTS_DIR=~/Documents/weights/openbeast/DeepSeek-V4.1-Flash-1017-EXL3-4.0bpw  # USER: where our quant would land
LICENCES='weights=mit; engine=apache-2.0'  # VERIFIED: investigation section 6
# what the checkpoint is (from the 2.9 pack: the same architecture)
ARCHITECTURE=DeepseekV41ForCausalLM  # READ: the 2.9 pack config.json
MODEL_TYPE=deepseek_v41  # READ: the 2.9 pack config.json
FORMAT=exl3  # USER
BPW=4.0  # USER
EXL3_CODEBOOK=mul1  # VERIFIED: what the fork reads
LAYERS=40  # READ
ATTENTION_HEADS=64  # READ
KV_HEADS=1  # READ
NATIVE_CONTEXT=1048576  # READ
EXPERTS=384  # READ
EXPERTS_ACTIVE=6  # READ
# serving choices
SPARKS=2  # USER: what we have
ENGINE=tf-fork-dsv41  # USER: the only engine that serves deepseek_v41 on a GB10
LAUNCHER=mia-unit:deepseek-v41-inference  # USER: the family's unit, but it serves the 2.9 pack at TP2 only: the plan shows gap launcher (Mia's 4-Spark recipe is not wired)
SERVED_NAME=DeepSeek-V4.1-Flash-1017  # VERIFIED
PORT=8000  # DEFAULT
CONTEXT=524288  # VERIFIED: the 2.9 recipe
PARALLEL=4  # VERIFIED
KV_DTYPE=fp4-compressed  # VERIFIED
KV_POOL_GIB=1.8  # VERIFIED
MEMORY_RESERVE_GIB=12.2  # VERIFIED: do not lower
DRAFTER=in-checkpoint:dspark  # READ: the 2.9 pack (quantize it in, at 4 bits)
AUX='Engram tables: deepseek-ai/DeepSeek-V4.1-Flash-1017@1bae0e10 shards 47 and 48 (203 GB) on every Spark local disk'  # VERIFIED
RANK_INPUTS='tf-dsv41-rank-cache MODEL DIR R 4 on the tp4 branch tools'  # VERIFIED: the DeepSeek recipe zig-engine.md
