# beast-recipe glm53-flash-exl3-native-tp2: GLM-5.3-Flash EXL3 4bpw (TR3) on native TensorFold 1.2.10,
# TP2 through D2 (spark-cluster.sh + tensorfold/spark-node.sh): OUR launcher, no Mia image. Candidate 1
# of the investigation: it proves an own recipe on the pair and qualifies D2, on weights both Sparks hold.
# The checkpoint is Max's abliterated copy of Mia-AiLab/GLM-5.3-Flash-EXL3-4bpw-TensorFold (the profile
# glm53-flash-ablit-exl3-tensorfold describes it); its files are locked by that profile's lock, copied to
# this recipe's profile (recipe-glm53-flash-exl3-native-tp2.lock). The drafter is re-pinned to the
# Apache-2.0 DFlash2 revision 6cc6c481 (byte-identical weights to the CC BY-NC-ND pin bf582e4e).
# Made by `beast-recipe init Mia-AiLab/GLM-5.3-Flash-EXL3-4bpw-TensorFold@76c0b517 --engine tf-native-1.2.10`
# (2026-11-22: the same layout, read from the Hub), then SOURCE pointed at the local copy by hand.
#
# Parsed, never sourced (scripts/backends/pylib/recipe.py). Provenance after each value: READ = the
# files of the checkpoint (beast-recipe init), HUB = the Hub API, DATA = data/recipe-engines.json,
# MEASURED / VERIFIED / CLAIMED / ESTIMATED as in the investigation, VERIFY = check on hardware.
# docs/BEAST_RECIPE.md

# identity
TITLE='GLM-5.3-Flash EXL3 4bpw (Ablit) on native TensorFold 1.2.10, TP2, our own launcher'  # USER
SOURCE=/home/max/openbeast-models/glm53-flash-ablit-exl3  # VERIFIED: models/glm53-flash-ablit-exl3-tensorfold.env (on both Sparks)
WEIGHTS_STATUS=local  # VERIFIED: on both Sparks, locked by the profile lock
WEIGHTS_DIR=/home/max/openbeast-models/glm53-flash-ablit-exl3  # VERIFIED
LICENCES='weights=mit (GLM-5.3-Flash; Mia pack apache-2.0); drafter=apache-2.0 (6cc6c481); engine=apache-2.0'  # VERIFIED: investigation section 6
# what the checkpoint is (read by model_inspect.py)
ARCHITECTURE=Glm5NextForConditionalGeneration  # READ: config.json architectures
MODEL_TYPE=glm5_next  # READ: config.json model_type
FORMAT=exl3  # READ: EXL3 4 bpw, mcg codebook, scope glm53_routed_experts_only
BPW=4  # READ: quantization_config.bits
EXL3_CODEBOOK=mcg  # READ: quantization_config.codebook
EXL3_SCOPE=glm53_routed_experts_only  # READ: quantization_config.scope
WEIGHT_BYTES=175642267944  # MEASURED: 83 shards on spark-1, 2026-11-22 (= the Hub pack, 163.6 GiB)
LAYERS=45  # READ: config.json
ATTENTION_HEADS=64  # READ: config.json
# KV_BYTES_PER_TOKEN= (not set: MLA latent 512 x 0 layers x 2 B)
NATIVE_CONTEXT=1048576  # READ: config.json max_position_embeddings
EXPERTS=288  # READ: config.json
EXPERTS_ACTIVE=8  # READ: config.json
# serving choices
SPARKS=2  # USER: the pair
ENGINE=tf-native-1.2.10  # USER: installed on both Sparks (tensorfold --version, 2026-11-22)
LAUNCHER=d2-tensorfold  # DATA: the engine's launcher
PROFILE=recipe-glm53-flash-exl3-native-tp2  # USER: rendered by beast-recipe up --write-profile (committed)
SERVED_NAME=glm-5.3-flash-ablit  # VERIFIED: the existing profile's SERVED_MODEL_NAME
PORT=8000  # DEFAULT
CONTEXT=524288  # MEASURED 2026-11-23 (with DENSE_BITS=4 and the 11.5 reserve): start line "4 streams at once, 3.66 GiB each at a 524288-token window, of 16.1 GiB left"; 9/9, 41.8 / 64.7 tok/s (docs/reports/GLM_SERVING_WINDOW-2026-11-23.md). Was 245760, the existing profile's value
PARALLEL=4  # DEFAULT
KV_DTYPE=fp8  # CLAIMED: Mia GLM 1104 (fp8 shared pages). Rendered as TENSORFOLD_KV_CACHE=fp8 (native --kv-cache fp8, an opt-in upstream does NOT qualify: 'BF16 remains the default and the only qualified cache'). VERIFY on the first serve; the fallback is bf16, which needs the KV re-budgeted (13,056 vs 6,960 B a token a rank)
KV_POOL_GIB=10  # VERIFIED: our Mia GLM local.sh KV_POOL_GIB
MEMORY_RESERVE_GIB=11.5  # MEASURED 2026-11-23: MemAvailable bottomed at 18.3 / 19.4 GiB under the 4-stream bench plus a concurrent 214K-token needle, command center up (at 17.5 it was 16.3 / 17.4 with 6.9 GiB left to the engine). Passed to every rank as TENSORFOLD_MEMORY_RESERVE_GIB. Was 17.5 (our Mia GLM local.sh; Mia's 1104 config.sh defaults to 6.5, read on spark-1 2026-11-23). The family's floor in data/recipe-engines.json (plan warns below it)
DENSE_BITS=4  # MEASURED 2026-11-23: rendered as TF_GLM_DENSE_BITS=4 on every rank (TENSORFOLD_RANK_ENV); "model 82.36 GiB" vs 87.69 bf16 dense, 42.2 / 65.8 tok/s vs 30.7 / 57.7 (set by hand that window, at 245760 / 17.5: docs/reports/GLM_SERVING_WINDOW-2026-11-23.md). VERIFY: re-run check --run --bench on the committed render (4-bit, 524288, 11.5); expect the start line "model 84.33 GiB; 4 streams at once, 3.66 GiB each at a 524288-token window, of 16.1 GiB left after a 11.5 GiB reserve" and about 41.8 / 64.7 tok/s
DRAFTER=incoai/GLM-5.3-Flash-DFlash2@6cc6c481eee930a5139619ed919f78726371adbc  # VERIFIED: Hub API, Apache-2.0 since 2026-11-10, same blob as bf582e4e
TOOL_PARSER=glm47  # ESTIMATED: model_inspect from the template; conformance decides
REASONING_PARSER=glm47  # ESTIMATED: model_inspect; conformance decides
